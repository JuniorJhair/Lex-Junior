<Window x:Class="LexJuniorPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lex Junior Player"
        Width="980" Height="680" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Background="#090D16"
        Foreground="#F8FAFC">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Custom Title / Header Bar -->
            <Border Grid.Row="0" Background="#0D1320" BorderBrush="#1C263B" BorderThickness="0,0,0,1" Padding="16,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/lex_junior_player.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LEX JUNIOR PLAYER" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Motor x86_64 (apps ARM + x86_64) · GPU · Solo APKs streaming" FontSize="10.5" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#131B2C" BorderBrush="#23304A" BorderThickness="1" CornerRadius="14" Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#64748B" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusPillText" Text="Motor detenido (0 MB RAM)" FontSize="11.5" FontWeight="Medium" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- Header Action + Chrome Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="PrereqsBtn" Content="🩺 Requisitos" Style="{StaticResource SecondaryBtn}"
                                Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="PrereqsBtn_Click" ToolTip="Verificar Android SDK, aceleración WHPX/AEHD y componentes faltantes"/>
                        <Button x:Name="SyncBtn" Content="↻ Sincronizar" Style="{StaticResource SecondaryBtn}"
                                Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="SyncBtn_Click" ToolTip="Detectar APKs instaladas"/>
                        <Button x:Name="PowerBtn" Content="⏻ Apagar Motor" Style="{StaticResource SecondaryBtn}"
                                Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="PowerBtn_Click" IsEnabled="False"/>
                        <Button x:Name="SettingsBtn" Content="⚙ Ajustes" Style="{StaticResource SecondaryBtn}"
                                Padding="10,5" FontSize="11.5" Margin="0,0,10,0" Click="SettingsBtn_Click"/>
                        <Button Content="—" Style="{StaticResource WindowChromeBtn}" Click="MinimizeBtn_Click"/>
                        <Button Content="☐" Style="{StaticResource WindowChromeBtn}" Click="MaximizeBtn_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowChromeBtn}" Foreground="#FDA4AF" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="24,18,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Install / Update Dropzone Hero -->
                <Border x:Name="DropZoneBorder" Grid.Row="0" Background="#101827" BorderBrush="#263450"
                        BorderThickness="1.5" CornerRadius="14" Padding="20,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Instalar o actualizar aplicación (.APK / .XAPK / .APKS / .APKM)" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="DropHintText"
                                       Text="Arrastra cualquier archivo .apk, .xapk, .apks o .apkm a esta ventana (solo optimizado para apps de streaming; si ya está instalada, actualiza conservando datos)."
                                       FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BrowseApkBtn" Grid.Column="1" Content="+ Buscar APK / XAPK en PC"
                                Style="{StaticResource PrimaryBtn}" VerticalAlignment="Center" Click="BrowseApkBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Emulator Window & Navigation Bar -->
                <Border Grid.Row="1" Background="#0D1424" BorderBrush="#1F2D47" BorderThickness="1"
                        CornerRadius="10" Padding="14,8" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ToggleSidebarBtn" Content="◫ Barra derecha: Oculta"
                                    Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0"
                                    Click="ToggleSidebarBtn_Click"
                                    ToolTip="Oculta o vuelve a mostrar los botones flotantes del borde derecho del emulador"/>
                            <Button x:Name="AutoFullscreenToggleBtn" Content="⛶ Auto pantalla completa: NO"
                                    Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="11.5"
                                    Click="AutoFullscreenToggleBtn_Click"
                                    ToolTip="Si está en SÍ, cada app que abras se iniciará directo en pantalla completa"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="AndroidBackBtn" Content="◀ Atrás" Style="{StaticResource SecondaryBtn}"
                                    Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="AndroidBackBtn_Click"
                                    IsEnabled="False" ToolTip="Enviar botón Atrás a Android"/>
                            <Button x:Name="AndroidHomeBtn" Content="⌂ Inicio" Style="{StaticResource SecondaryBtn}"
                                    Padding="10,5" FontSize="11.5" Margin="0,0,10,0" Click="AndroidHomeBtn_Click"
                                    IsEnabled="False" ToolTip="Ir al inicio dentro de Android"/>
                            <Button x:Name="MaximizeEmuBtn" Content="🗖 Ventana grande" Style="{StaticResource SecondaryBtn}"
                                    Padding="11,5" FontSize="11.5" Margin="0,0,6,0" Click="MaximizeEmuBtn_Click"
                                    IsEnabled="False" ToolTip="Ajustar la ventana al tamaño máximo sin tapar la barra de tareas"/>
                            <Button x:Name="FullscreenBtn" Content="⛶ Pantalla completa (F11)" Style="{StaticResource PrimaryBtn}"
                                    Padding="13,6" FontSize="12" Click="FullscreenBtn_Click"
                                    IsEnabled="False" ToolTip="Activar o salir de pantalla completa sin bordes (también con F11 sobre el video)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section Header -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Mis Aplicaciones de Video" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#182338" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppCountText" Text="0 apps" FontSize="11.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SdkReadyText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>
                </Grid>

                <!-- Apps List + Empty State -->
                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AppsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111827" BorderBrush="#222E46" BorderThickness="1"
                                            CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#192338" HorizontalAlignment="Left">
                                                <Grid>
                                                    <TextBlock Text="{Binding Monogram}" FontSize="17" FontWeight="Bold" Foreground="#38BDF8"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding IconBitmap}" Width="46" Height="46" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Clip>
                                                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,46,46"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <!-- App Metadata -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,16,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppName}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                    <Border Background="#192942" BorderBrush="#2B4268" BorderThickness="1" CornerRadius="6" Padding="7,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                                                    </Border>
                                                    <Border Background="#172033" CornerRadius="6" Padding="7,1" Margin="6,0,0,0"
                                                            Visibility="{Binding HasAbiLabel}">
                                                        <TextBlock Text="{Binding SupportedAbis}" FontSize="10.5" Foreground="#94A3B8"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PackageName}" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶ Abrir" Style="{StaticResource PrimaryBtn}" Padding="16,8" Margin="0,0,8,0"
                                                        Tag="{Binding}" Click="LaunchApp_Click"/>
                                                <Button Content="↻ Actualizar" Style="{StaticResource SecondaryBtn}" Padding="12,8" Margin="0,0,8,0"
                                                        Tag="{Binding}" Click="UpdateApp_Click" ToolTip="Elegir una versión más reciente (.apk)"/>
                                                <Button Content="Desinstalar" Style="{StaticResource DangerBtn}" Padding="12,8"
                                                        Tag="{Binding}" Click="UninstallApp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <Border x:Name="EmptyStateCard" Background="#0E1523" BorderBrush="#1E293B" BorderThickness="1"
                            CornerRadius="14" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/lex_junior_player.png" Width="64" Height="64" Margin="0,0,0,14"/>
                            <TextBlock Text="Aún no has agregado ninguna APK" FontSize="17" FontWeight="Bold"
                                       Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Arrastra aquí tu archivo .apk, .xapk o .apks (Magma, Streamflix, Kodi o cualquier app de video Android) o haz clic en '+ Buscar APK / XAPK en PC'."
                                       FontSize="13" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18"/>
                            <Button Content="+ Buscar APK / XAPK en PC" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Center" Click="BrowseApkBtn_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer Progress / Info Bar -->
            <Border Grid.Row="2" Background="#0C121E" BorderBrush="#1C263B" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="BusyBar" Width="130" Height="6" IsIndeterminate="True" Foreground="#00D4FF"
                                     Background="#1E293B" BorderThickness="0" Margin="0,0,12,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="FooterStatusText" Text="Listo. El motor Android permanece apagado hasta que abras o instales una app."
                                   FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Lex Junior Player v1.1 · Motor x86_64 (apps ARM + x86_64) limpio"
                               FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Custom Dark Modal Overlay (Install/Update/Uninstall/Error) -->
            <Border x:Name="ModalOverlay" Grid.RowSpan="3" Background="#B8050811" Visibility="Collapsed" Padding="24">
                <Border Background="#111827" BorderBrush="#2E3F60" BorderThickness="1.5" CornerRadius="14"
                        MaxWidth="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="ModalTitleText" Text="Confirmar acción" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="ModalBodyText" Text="" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,10,0,18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ModalCancelBtn" Content="Cancelar" Style="{StaticResource SecondaryBtn}"
                                    Margin="0,0,10,0" Click="ModalCancel_Click"/>
                            <Button x:Name="ModalConfirmBtn" Content="Confirmar" Style="{StaticResource PrimaryBtn}"
                                    Click="ModalConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>

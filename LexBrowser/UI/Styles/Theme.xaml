<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================== -->
    <!-- PALETA DE COLORES Y BROCHAS OFICIALES (MAPA WCAG 2.1 AA) -->
    <!-- ======================================================== -->
    
    <!-- Texto -->
    <Color x:Key="ColorTextTitle">#FFFFFF</Color>
    <SolidColorBrush x:Key="BrushTextTitle" Color="{StaticResource ColorTextTitle}"/>

    <Color x:Key="ColorTextSubtitle">#A1A1AA</Color>
    <SolidColorBrush x:Key="BrushTextSubtitle" Color="{StaticResource ColorTextSubtitle}"/>

    <!-- Texto secundario: #A1A1AA (sustituye a #71717A y #52525B con ratio > 5.5:1 en todas las superficies WCAG AA) -->
    <Color x:Key="ColorTextSecondary">#A1A1AA</Color>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>

    <!-- Gris compliant verificado (7.5:1) -->
    <Color x:Key="ColorTextCompliantGray">#9CA3AF</Color>
    <SolidColorBrush x:Key="BrushTextCompliantGray" Color="{StaticResource ColorTextCompliantGray}"/>

    <!-- Fondos y Superficies -->
    <Color x:Key="ColorAppBackground">#0F0F14</Color>
    <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource ColorAppBackground}"/>

    <Color x:Key="ColorWindowBackground">#12121A</Color>
    <SolidColorBrush x:Key="BrushWindowBackground" Color="{StaticResource ColorWindowBackground}"/>

    <Color x:Key="ColorSurfaceDark">#15151D</Color>
    <SolidColorBrush x:Key="BrushSurfaceDark" Color="{StaticResource ColorSurfaceDark}"/>

    <Color x:Key="ColorSurfaceMedium">#171722</Color>
    <SolidColorBrush x:Key="BrushSurfaceMedium" Color="{StaticResource ColorSurfaceMedium}"/>

    <Color x:Key="ColorSurfaceCard">#1B1B26</Color>
    <SolidColorBrush x:Key="BrushSurfaceCard" Color="{StaticResource ColorSurfaceCard}"/>

    <!-- Bordes -->
    <Color x:Key="ColorBorderDefault">#28283C</Color>
    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBorderDefault}"/>

    <Color x:Key="ColorBorderSubtle">#2E2E3E</Color>
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>

    <!-- Acentos (WCAG 2.1 AA verificado con texto blanco) -->
    <Color x:Key="ColorAccentIndigo">#4F46E5</Color>
    <SolidColorBrush x:Key="BrushAccentIndigo" Color="{StaticResource ColorAccentIndigo}"/>

    <Color x:Key="ColorAccentEmerald">#34D399</Color>
    <SolidColorBrush x:Key="BrushAccentEmerald" Color="{StaticResource ColorAccentEmerald}"/>

    <Color x:Key="ColorAccentDanger">#DC2626</Color>
    <SolidColorBrush x:Key="BrushAccentDanger" Color="{StaticResource ColorAccentDanger}"/>

    <!-- ======================================================== -->
    <!-- ESTILO DE FOCO ACCESIBLE DE TECLADO VISIBLE               -->
    <!-- ======================================================== -->
    <Style x:Key="LexFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="#818CF8" StrokeThickness="1.5" StrokeDashArray="2 2" RadiusX="5" RadiusY="5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!-- ESTILOS BASE INFORMATIVOS Y CONTROLES CORE               -->
    <!-- ======================================================== -->

    <!-- TextBlock informativo con wrapping automático y contraste seguro -->
    <Style x:Key="InformativeTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <!-- Botón Estándar de la Plataforma -->
    <Style x:Key="LexBaseButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
        <Setter Property="Background" Value="#22222E"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextTitle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Border x:Name="HoverOverlay" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Background" Value="#1FFFFFFF"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushAccentIndigo}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Background" Value="#26000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón Primario (Acento Indigo WCAG AA 5.8:1) -->
    <Style x:Key="LexPrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
        <Setter Property="Background" Value="#4F46E5"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#4338CA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3730A3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


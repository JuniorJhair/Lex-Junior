<Window x:Class="LexBrowser.UI.Views.NotificationToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notificación Web"
        Width="360" Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize">

    <Border x:Name="ToastCard" Background="#181824" BorderBrush="#3D385E" BorderThickness="1.5"
            CornerRadius="12" Padding="14,10" Margin="10" Cursor="Hand"
            MouseEnter="ToastCard_MouseEnter" MouseLeave="ToastCard_MouseLeave" MouseLeftButtonUp="ToastCard_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.7" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icono / Favicon del sitio -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#232334"
                    BorderBrush="#312E81" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,12,0">
                <Grid>
                    <TextBlock x:Name="TxtFallbackIcon" Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="ImgFavicon" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Contenido textual -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera: Dominio y botón cerrar -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="TxtHost" Text="origen.com" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#818CF8" TextTrimming="CharacterEllipsis" MaxWidth="240"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource LexGhostButton}" Content="✕" Width="22" Height="22"
                            Padding="0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="BtnClose_Click" ToolTip="Cerrar notificación"/>
                </Grid>

                <!-- Título -->
                <TextBlock x:Name="TxtTitle" Grid.Row="1" Text="Título de notificación" FontSize="12.5"
                           FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,2"/>

                <!-- Cuerpo -->
                <TextBlock x:Name="TxtBody" Grid.Row="2" Text="Cuerpo informativo de la notificación web..."
                           FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" MaxHeight="38"
                           TextTrimming="CharacterEllipsis" LineHeight="15"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="LexBrowser.UI.Views.PasswordDisablePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desactivar Guardador de Contraseñas - Lex Junior"
        Height="410" Width="510"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#121218" BorderBrush="#2D2D3E" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.65" Color="Black"/>
        </Border.Effect>
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="38" Height="38" CornerRadius="9" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🔑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="¿Qué deseas hacer con tus contraseñas guardadas?" FontWeight="Bold" FontSize="14.5" Foreground="#FFFFFF"/>
                    <TextBlock Text="Elige si deseas conservarlas por si vuelves a activar el guardador o eliminarlas" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Explicación detallada de cada opción -->
            <Border Grid.Row="1" Background="#171722" BorderBrush="#27273A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtSavedCountInfo" Text="Tienes 0 contraseñas guardadas en tu bóveda cifrada." FontWeight="Bold" FontSize="12" Foreground="#818CF8" Margin="0,0,0,6"/>
                    <TextBlock Text="• Si eliges MANTENERLAS: Lex Junior dejará de preguntar y autocompletar en las páginas web, pero tus contraseñas actuales seguirán guardadas bajo llave para cuando vuelvas a activarlo."
                               FontSize="11" Foreground="#D4D4D8" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Si eliges ELIMINARLAS: Se desactivará el guardador y se borrarán todas las contraseñas guardadas de forma permanente."
                               FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Botones de Acción -->
            <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                <!-- Opción 1: Mantener por si vuelve a activar (Recomendado) -->
                <Button x:Name="BtnKeepAndDisable" Content="📦 Mantener mis contraseñas guardadas (Pausar guardador)"
                        Style="{StaticResource LexPrimaryButton}" FontWeight="Bold" FontSize="12" Padding="12,10"
                        Margin="0,0,0,8" Click="BtnKeepAndDisable_Click"/>

                <!-- Opción 2: Eliminar todas las guardadas -->
                <Button x:Name="BtnDeleteAndDisable" Content="🗑️ Eliminar todas las contraseñas guardadas y desactivar"
                        Style="{StaticResource LexDangerButton}" FontWeight="SemiBold" FontSize="12" Padding="12,9"
                        Margin="0,0,0,8" Click="BtnDeleteAndDisable_Click"/>

                <!-- Cancelar -->
                <Button Content="Cancelar (Seguir con el guardador activo)"
                        Style="{StaticResource LexGhostButton}" Foreground="#A1A1AA" FontSize="11.5" Padding="8,6"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>


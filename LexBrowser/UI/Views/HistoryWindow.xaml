<Window x:Class="LexBrowser.UI.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial y Limpieza de Navegación - Lex Junior"
        Height="720" Width="980"
        MinHeight="550" MinWidth="750"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F0F14"
        Foreground="#E4E4E7"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Estilo Pestañas Superiores -->
        <Style x:Key="HeaderTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Moderno -->
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                            <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="#2E2E3A" Margin="10,0,0,0">
                                <Ellipse x:Name="thumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de Acción Estándar -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#22222E"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2F2F40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2E2E40"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1C1C28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Primario Peligro / Borrado -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#E11D48"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#BE123C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#9F1239"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Box Oscuro -->
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#171720"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#2E2E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#818CF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Oscura Moderna y Suave -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#333348" CornerRadius="5" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#4F4F72"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#6366F1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton Oscuro Moderno -->
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="OuterCircle" Width="18" Height="18" CornerRadius="9"
                                    Background="#171720" BorderBrush="#3B3B4E" BorderThickness="1.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="#6366F1" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="#818CF8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="OuterCircle" Property="Background" Value="#1E1E30"/>
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Selección Oscura -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="#171720" BorderBrush="#3B3B4E" BorderThickness="1.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 15 4" Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                      Margin="1,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#818CF8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo ComboBoxItem Oscuro -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>

        <!-- ToggleButton para ComboBox Oscuro -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                        Background="#171720" BorderBrush="#2E2E3E" BorderThickness="1"/>
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A1A1AA"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                    <Setter TargetName="Border" Property="Background" Value="#1C1C28"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#6366F1"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Estilo ComboBox Oscuro Completo -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,7,28,7"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="#F4F4F5"/>
                                </TextBlock.Foreground>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="260">
                                    <Border x:Name="DropDownBorder"
                                            Background="#14141E"
                                            BorderBrush="#2E2E40"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                            Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkCombo}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Barra de título draggable -->
            <RowDefinition Height="42"/>
            <!-- 1: Banner de control maestro de Historial (Activar/Desactivar) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Contenido dinámico (Explorador o Limpieza Avanzada) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Border Grid.Row="0" Background="#14141A" BorderBrush="#242430" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="20" Height="20" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Historial y Limpieza Avanzada de Navegación" FontWeight="Bold" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Pestañas de modo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="TabExplore" Content="📚 Explorar Historial" Style="{StaticResource HeaderTabBtn}" IsChecked="True" Checked="ModeTab_Checked"/>
                    <RadioButton x:Name="TabClearAdvanced" Content="🧹 Limpieza Avanzada de Datos" Style="{StaticResource HeaderTabBtn}" Checked="ModeTab_Checked"/>
                </StackPanel>

                <!-- Botón cerrar -->
                <Button Grid.Column="2" Content="✕" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="#A1A1AA" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#E11D48"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Banner de interruptor de historial (Activar / Desactivar) -->
        <Border Grid.Row="1" Background="#16161F" BorderBrush="#262636" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Guardar historial de navegación" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                        <Border x:Name="BadgeHistoryStatus" Background="#1E3A8A" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHistoryStatus" Text="ACTIVO" FontSize="9" FontWeight="Bold" Foreground="#93C5FD"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Si está desactivado, el navegador no guarda páginas ni rutas visitadas, ahorrando memoria y espacio en disco por completo." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="TxtStorageInfo" Text="Espacio: Calculando..." FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox x:Name="ToggleHistoryActive" Grid.Column="2" Style="{StaticResource ModernToggle}" VerticalAlignment="Center" Click="ToggleHistoryActive_Click"/>
            </Grid>
        </Border>

        <!-- SECCIÓN 1: VISTA DE EXPLORACIÓN DE HISTORIAL -->
        <Grid x:Name="ViewExplorer" Grid.Row="2" Visibility="Visible">
            <Grid.RowDefinitions>
                <!-- Filtros y buscador -->
                <RowDefinition Height="Auto"/>
                <!-- Lista de historial -->
                <RowDefinition Height="*"/>
                <!-- Barra de estado inferior -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de Filtros Pro -->
            <Border Grid.Row="0" Background="#111116" BorderBrush="#20202B" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 1: Buscador y filtros principales -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!-- Buscador texto -->
                            <ColumnDefinition Width="2*"/>
                            <!-- Filtro dominio -->
                            <ColumnDefinition Width="1.5*"/>
                            <!-- Filtro tiempo -->
                            <ColumnDefinition Width="1.2*"/>
                            <!-- Botón limpiar todo -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Buscador instantáneo -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox x:Name="TxtSearch" Style="{StaticResource DarkInput}" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="🔍 Buscar por título, URL o palabra clave..." IsHitTestVisible="False" Foreground="#52525B" FontSize="12" Margin="12,7,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Filtro por dominio inteligente -->
                        <ComboBox x:Name="CboDomainFilter" Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="0,0,10,0" SelectionChanged="CboDomainFilter_SelectionChanged"/>

                        <!-- Filtro por fecha rápida -->
                        <ComboBox x:Name="CboDateFilter" Grid.Column="2" Style="{StaticResource DarkCombo}" Margin="0,0,10,0" SelectionChanged="CboDateFilter_SelectionChanged">
                            <ComboBoxItem Content="Todas las fechas" IsSelected="True"/>
                            <ComboBoxItem Content="Hoy"/>
                            <ComboBoxItem Content="Ayer"/>
                            <ComboBoxItem Content="Últimos 7 días"/>
                            <ComboBoxItem Content="Últimos 30 días"/>
                        </ComboBox>

                        <!-- Botón directo para limpiar todo -->
                        <Button Grid.Column="3" Content="🧹 Limpiar Datos..." Style="{StaticResource ActionBtn}" Click="BtnOpenClearModal_Click"/>
                    </Grid>

                    <!-- Fila 2: Chips informativos / Acciones rápidas -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Sitios frecuentes:" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <WrapPanel x:Name="DomainChipsPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lista / Tabla de Historial con Desplazamiento Suave en Píxeles (Sin saltos bruscos) -->
            <ListView x:Name="LstHistory" Grid.Row="1" Background="#0C0C10" BorderThickness="0" Foreground="#E4E4E7"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="False"
                      PreviewMouseWheel="LstHistory_PreviewMouseWheel">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#1A1A24"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#171722"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E1E2E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Hora -->
                                <ColumnDefinition Width="70"/>
                                <!-- Favicon -->
                                <ColumnDefinition Width="28"/>
                                <!-- Título, URL y Dominio -->
                                <ColumnDefinition Width="*"/>
                                <!-- Acciones: Limpiar sitio y Eliminar -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Zona clickeable completa que cubre toda la fila excepto los botones de acción -->
                            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="HistoryRow_Click"/>

                            <!-- Hora -->
                            <TextBlock Grid.Column="0" Text="{Binding DisplayTime}" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" IsHitTestVisible="False"/>

                            <!-- Favicon / Ícono Oficial -->
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="4" Background="#1C1C26" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <Grid>
                                    <Image Source="{Binding FaviconImage}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="🌐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasNoFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- Contenido Principal -->
                            <StackPanel Grid.Column="2" Margin="6,0,16,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="#20202F" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Domain}" FontSize="10" Foreground="#818CF8" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Url}" Foreground="#52525B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Botones de Acción por fila -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🌐 Limpiar este sitio" Style="{StaticResource ActionBtn}" Padding="8,4" Margin="0,0,6,0" ToolTip="Elimina cookies, caché y sesiones activas de este dominio" Click="BtnCleanSite_Click"/>
                                <Button Content="✕" Style="{StaticResource ActionBtn}" Padding="8,4" Foreground="#F43F5E" ToolTip="Eliminar esta entrada del historial" Click="BtnDeleteSingle_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Barra inferior con paginación inteligente y contadores -->
            <Border Grid.Row="2" Background="#111116" BorderBrush="#20202B" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lado Izquierdo: Contador y Selector por página -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHistoryCount" Text="Cargando historial..." FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Mostrar:" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbPageSize" Width="60" Height="24" Background="#1B1B26" Foreground="#FFFFFF" BorderBrush="#2B2B3C" BorderThickness="1"
                                  FontSize="11" VerticalContentAlignment="Center" SelectionChanged="CmbPageSize_SelectionChanged">
                            <ComboBoxItem Content="50" IsSelected="True"/>
                            <ComboBoxItem Content="100"/>
                            <ComboBoxItem Content="200"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Centro: Navegación de Páginas -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnPrevPage" Content="◀ Anterior" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11" Margin="0,0,8,0" Click="BtnPrevPage_Click"/>
                        <TextBlock x:Name="TxtPageInfo" Text="Pág. 1 de 1" FontSize="11" FontWeight="SemiBold" Foreground="#818CF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnNextPage" Content="Siguiente ▶" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11" Click="BtnNextPage_Click"/>
                    </StackPanel>

                    <!-- Lado Derecho: Acciones de borrado -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🗑️ Eliminar día seleccionado" Style="{StaticResource ActionBtn}" Padding="10,4" Margin="0,0,8,0" Click="BtnDeleteDay_Click"/>
                        <Button Content="Vaciar todo el historial" Style="{StaticResource ActionBtn}" Foreground="#F43F5E" Padding="10,4" Click="BtnClearAll_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- SECCIÓN 2: LIMPIEZA AVANZADA DE DATOS (NIVEL SENIOR) -->
        <ScrollViewer x:Name="ViewClearAdvanced" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="32,24">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Limpieza Avanzada de Datos y Sitios Web" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock Text="Elimina selectivamente cookies, contraseñas, inicios de sesión y caché de manera global o de un solo sitio web." FontSize="12" Foreground="#71717A" Margin="0,0,0,24"/>

                <!-- 1. Alcance de la limpieza (Todo vs Sitio Específico) -->
                <Border Background="#15151F" BorderBrush="#252538" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. ÁMBITO DE LA LIMPIEZA" FontSize="11" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,12"/>

                        <RadioButton x:Name="RbScopeAll" Content="🌐 Limpiar todo el navegador (Afecta a todos los sitios web)" GroupName="ClearScope" IsChecked="True" Style="{StaticResource DarkRadio}" Margin="0,4"/>
                        <RadioButton x:Name="RbScopeSite" Content="🎯 Limpiar únicamente un sitio web específico (No afectará a las demás páginas)" GroupName="ClearScope" Style="{StaticResource DarkRadio}" Margin="0,6"/>

                        <!-- Selector del sitio web cuando RbScopeSite está activo -->
                        <Grid Margin="24,8,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbScopeSite}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sitio a limpiar:" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CboScopeTargetDomain" Grid.Column="1" Style="{StaticResource DarkCombo}"/>
                            <TextBlock Text="(ej: youtube.com, futbollibresgol.pe)" Grid.Column="2" FontSize="11" Foreground="#52525B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Rango de tiempo ultra granular -->
                <Border Background="#15151F" BorderBrush="#252538" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="2. INTERVALO DE TIEMPO" FontSize="11" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Eliminar desde hace:" FontSize="12" Foreground="#F4F4F5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="CboClearTimePreset" Grid.Column="1" Style="{StaticResource DarkCombo}" SelectionChanged="CboClearTimePreset_SelectionChanged">
                                <ComboBoxItem Content="Última hora" IsSelected="True"/>
                                <ComboBoxItem Content="Últimas 24 horas"/>
                                <ComboBoxItem Content="Últimos 7 días"/>
                                <ComboBoxItem Content="Últimas 4 semanas"/>
                                <ComboBoxItem Content="Desde el principio (Todo)"/>
                                <ComboBoxItem Content="⏱️ Tiempo personalizado..."/>
                            </ComboBox>
                        </Grid>

                        <!-- Selector personalizado de Años, Meses, Días, Horas, Minutos, Segundos -->
                        <Border x:Name="PanelCustomTime" Background="#1B1B26" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Especifica exactamente cuánto tiempo atrás deseas borrar:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,10"/>
                                <WrapPanel Orientation="Horizontal">
                                    <!-- Años -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                        <TextBox x:Name="TxtCustomYears" Text="0" Width="44" Style="{StaticResource DarkInput}"/>
                                        <TextBlock Text="Años" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <!-- Meses -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                        <TextBox x:Name="TxtCustomMonths" Text="0" Width="44" Style="{StaticResource DarkInput}"/>
                                        <TextBlock Text="Meses" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <!-- Días -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                        <TextBox x:Name="TxtCustomDays" Text="0" Width="44" Style="{StaticResource DarkInput}"/>
                                        <TextBlock Text="Días" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <!-- Horas -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                        <TextBox x:Name="TxtCustomHours" Text="1" Width="44" Style="{StaticResource DarkInput}"/>
                                        <TextBlock Text="Horas" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <!-- Minutos -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                        <TextBox x:Name="TxtCustomMinutes" Text="0" Width="44" Style="{StaticResource DarkInput}"/>
                                        <TextBlock Text="Minutos" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <!-- Segundos -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                        <TextBox x:Name="TxtCustomSeconds" Text="0" Width="44" Style="{StaticResource DarkInput}"/>
                                        <TextBlock Text="Segundos" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Tabla Visual de Tipos de Datos a Eliminar -->
                <Border Background="#15151F" BorderBrush="#252538" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="3. SELECCIÓN ESTRATÉGICA DE ELEMENTOS A BORRAR" FontSize="11" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,14"/>

                        <!-- Historial -->
                        <Border Background="#191924" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox x:Name="ChkDataTypeHistory" IsChecked="True" Style="{StaticResource DarkCheck}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="📚 Historial de navegación y rutas visitadas" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Limpia los enlaces y títulos registrados en el historial de navegación." FontSize="11" Foreground="#71717A"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Cookies y Sesiones -->
                        <Border Background="#191924" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox x:Name="ChkDataTypeCookies" IsChecked="True" Style="{StaticResource DarkCheck}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="🍪 Cookies y sesiones de inicio activas" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Cierra sesiones activas en los sitios seleccionados y borra identificadores de seguimiento." FontSize="11" Foreground="#71717A"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Caché -->
                        <Border Background="#191924" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox x:Name="ChkDataTypeCache" IsChecked="True" Style="{StaticResource DarkCheck}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="⚡ Archivos e imágenes en caché" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Libera espacio en el disco duro eliminando archivos temporales descargados por las webs." FontSize="11" Foreground="#71717A"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Contraseñas y autocompletado -->
                        <Border Background="#191924" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox x:Name="ChkDataTypePasswords" IsChecked="False" Style="{StaticResource DarkCheck}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="🔑 Contraseñas y datos de autocompletado de formularios" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Elimina credenciales guardadas y sugerencias automáticas de texto escritas en formularios." FontSize="11" Foreground="#71717A"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Almacenamiento Local (DOM Storage / IndexedDB) -->
                        <Border Background="#191924" CornerRadius="6" Padding="12,10">
                            <CheckBox x:Name="ChkDataTypeLocalStorage" IsChecked="True" Style="{StaticResource DarkCheck}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="💾 Almacenamiento local del sitio (LocalStorage, IndexedDB, WebSQL)" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Elimina bases de datos offline, preferencias guardadas y estados locales de aplicaciones web." FontSize="11" Foreground="#71717A"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Botones de Confirmación de Borrado -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,32">
                    <Button Content="Cancelar" Style="{StaticResource ActionBtn}" Padding="16,8" Margin="0,0,12,0" Click="BtnCancelAdvanced_Click"/>
                    <Button x:Name="BtnExecuteClear" Content="🗑️ Ejecutar Limpieza Ahora" Style="{StaticResource DangerBtn}" Click="BtnExecuteClear_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


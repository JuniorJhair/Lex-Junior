<Window x:Class="LexBrowser.UI.Views.LexClassUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizaciones — Lex Junior Class"
        Width="560"
        MinWidth="440"
        MaxWidth="640"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="#090B14"
        Foreground="#F4F4F5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/lexclass.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="4" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="LexClassDialogAccent" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF6B00" Offset="0"/>
            <GradientStop Color="#9333EA" Offset="0.6"/>
            <GradientStop Color="#38BDF8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CosmicPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#818CF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FB923C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CosmicSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B1F30"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#2D334D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262C44"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#312E81" BorderThickness="1.2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="1.5"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="#0E111D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="6" Width="22" Height="22" Margin="0,0,9,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/lexclass.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="Actualizaciones — Lex Junior Class" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Grid.Column="1" Content="✕" Click="BtnClose_Click" Width="34" Height="30"
                            WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0"
                            Foreground="#94A3B8" FontSize="13" Cursor="Hand" ToolTip="Cerrar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E11D48"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource LexClassDialogAccent}" Opacity="0.78"/>

            <!-- Cabecera hero -->
            <Border Grid.Row="2" Background="#0E1324" BorderBrush="#1F2744" BorderThickness="0,0,0,1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13" Margin="0,0,14,0"
                            Background="#171C34" BorderBrush="#66FF6B00" BorderThickness="1.2" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/lexclass.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeadline" Text="Comprobando mundos..." FontSize="15.5" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtSubtitle" Text="Todo funciona 100 % local sin reinstalar el navegador." FontSize="11.8" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border x:Name="BadgeStatusPill" Grid.Column="2" Background="#1E1B4B" BorderBrush="#6366F1"
                            BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtStatusBadge" Text="v2.8.0" FontSize="11.5" FontWeight="Bold" Foreground="#C4B5FD"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Lista de mundos pendientes (solo visible cuando hay novedades) -->
            <ScrollViewer x:Name="WorldsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="270"
                          Padding="20,14,20,10" Visibility="Collapsed">
                <StackPanel x:Name="WorldsContainer"/>
            </ScrollViewer>

            <!-- Barra de progreso en vivo -->
            <Border x:Name="ProgressPanel" Grid.Row="4" Visibility="Collapsed"
                    Margin="20,4,20,12" Padding="14,11" CornerRadius="10"
                    Background="#11172B" BorderBrush="#2D3558" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtProgressStage" Text="Descargando paquete..." FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtProgressPercent" Grid.Column="1" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Grid>
                    <ProgressBar x:Name="BarProgress" Minimum="0" Maximum="100" Value="0" Height="7"
                                 Background="#1D243F" Foreground="#6366F1" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Botones de acción -->
            <Border Grid.Row="5" Background="#0E111D" BorderBrush="#1F2744" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtIntegrityFoot" Grid.Column="0" Text="🔒 Verificación SHA-256 · 100 % offline"
                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnLater" Content="Ahora no" Click="BtnClose_Click"
                                Style="{StaticResource CosmicSecondaryBtn}" Margin="0,0,10,0" IsCancel="True"/>
                        <Button x:Name="BtnPrimaryAction" Content="🔄 Actualizar ahora" Click="BtnPrimaryAction_Click"
                                Style="{StaticResource CosmicPrimaryBtn}" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

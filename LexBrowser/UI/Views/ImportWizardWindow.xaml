<Window x:Class="LexBrowser.UI.Views.ImportWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar datos de otro navegador — Lex Junior"
        Height="620" Width="620"
        MinHeight="540" MinWidth="560"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F0F14"
        Foreground="#E4E4E7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ModernToggle" TargetType="CheckBox" BasedOn="{StaticResource LexModernToggle}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de título oscura -->
        <Border Grid.Row="0" Background="#14141A" BorderBrush="#242430" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="📥 Importar datos de otro navegador — Lex Junior"
                               FontWeight="Bold" FontSize="12.5" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="36" Height="32"
                        Background="Transparent" BorderThickness="0" Foreground="#A1A1AA"
                        Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>
                <!-- Aviso recomendado -->
                <Border Background="#1B1926" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock Text="⚠ Para mejores resultados cierra el otro navegador antes de importar tus datos. Todo el proceso es local y sin conexión."
                               FontSize="12" Foreground="#FCD34D" TextWrapping="Wrap"/>
                </Border>

                <!-- Selección de navegador y perfil -->
                <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Navegador y perfil de origen" FontWeight="SemiBold" FontSize="13.5" Foreground="#F4F4F5" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbProfiles" Style="{StaticResource LexComboBox}" DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="CmbProfiles_SelectionChanged" IsEnabled="False"/>
                        <TextBlock x:Name="TxtProfileStatus" Text="Buscando navegadores compatibles (Chrome, Edge, Brave, Vivaldi, Opera)..."
                                   FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Categorías -->
                <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="¿Qué deseas importar?" FontWeight="SemiBold" FontSize="13.5" Foreground="#F4F4F5" Margin="0,0,0,10"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⭐ Marcadores" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                <TextBlock x:Name="TxtBookmarksHint" Text="Conserva los existentes sin duplicar URLs." FontSize="11" Foreground="#A1A1AA"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkImportBookmarks" Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#232332" Margin="0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🕒 Historial de navegación" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                <TextBlock x:Name="TxtHistoryHint" Text="Copia segura de solo lectura aunque el navegador siga abierto." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkImportHistory" Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#232332" Margin="0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🔐 Contraseñas (mejor esfuerzo v10/v11)" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                <TextBlock x:Name="TxtPasswordsHint" Text="No sobrescribe contraseñas existentes. Las contraseñas v20 requieren archivo CSV." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkImportPasswords" Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Progreso y resumen -->
                <Border x:Name="PanelProgress" Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10"
                        Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtProgressStatus" Text="Preparando..." FontSize="12" Foreground="#818CF8" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="ProgressImport" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Background="#1F1F2E" Foreground="#4F46E5" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelSummary" Background="#131922" BorderBrush="#2B3648" BorderThickness="1" CornerRadius="10"
                        Padding="16,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Resumen de importación" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtSummaryBody" FontSize="12" Foreground="#D4D4D8" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra inferior de acciones -->
        <Border Grid.Row="2" Background="#12121A" BorderBrush="#242430" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnImportCsv" Grid.Column="0" Content="📄 Importar desde archivo CSV…"
                        Style="{StaticResource LexSecondaryButton}" Padding="14,8" FontSize="12" FontWeight="SemiBold"
                        Click="BtnImportCsv_Click"/>

                <Button x:Name="BtnCancelImport" Grid.Column="2" Content="Cancelar"
                        Style="{StaticResource LexDangerButton}" Padding="14,8" FontSize="12" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="BtnCancelImport_Click"/>

                <Button x:Name="BtnImportProfile" Grid.Column="3" Content="Importar selección"
                        Style="{StaticResource LexPrimaryButton}" Padding="16,8" FontSize="12" FontWeight="Bold"
                        IsEnabled="False" Click="BtnImportProfile_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>


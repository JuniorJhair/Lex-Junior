<Window x:Class="LexBrowser.UI.Views.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador de Lex Junior Browser"
        Icon="pack://application:,,,/Assets/logo.png"
        Width="520" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#0F0F15" BorderBrush="#312E81" BorderThickness="1.5" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Botón Cerrar superior derecho -->
            <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="28" Height="28" Background="Transparent" Foreground="#8B8B96"
                    BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnClose_Click"/>

            <!-- Cabecera con Logo y Título -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                <Border CornerRadius="14" Width="56" Height="56" Margin="0,0,16,0" ClipToBounds="True" BorderBrush="#4F46E5" BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="LEX JUNIOR BROWSER" Foreground="#F4F4F5" FontSize="19" FontWeight="Black" Margin="0,0,10,0"/>
                        <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionBadge" Text="v1.0.0" Foreground="#818CF8" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="Instalador Oficial · Ultra-ligero · Bloquea la mayoría de anuncios · 0 Telemetría"
                               Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="#232332" Margin="0,0,0,16"/>

            <!-- Opciones de Instalación / Desinstalación -->
            <Grid Grid.Row="2">
                <!-- Panel de Instalación -->
                <StackPanel x:Name="PanelInstallOptions" VerticalAlignment="Top">
                    <TextBlock Text="Configuración de instalación:" Foreground="#D4D4D8" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkDesktopShortcut" IsChecked="True" Foreground="#E4E4E7" FontSize="12.5" Margin="0,0,0,10"
                              Content="Crear icono de acceso directo en el Escritorio"/>

                    <CheckBox x:Name="ChkStartMenuShortcut" IsChecked="True" Foreground="#E4E4E7" FontSize="12.5" Margin="0,0,0,10"
                              Content="Agregar al Menú Inicio y Aplicaciones de Windows"/>

                    <CheckBox x:Name="ChkLaunchAfterInstall" IsChecked="True" Foreground="#E4E4E7" FontSize="12.5" Margin="0,0,0,12"
                              Content="Iniciar Lex Junior Browser al terminar la instalación"/>

                    <TextBlock x:Name="TxtInstallLocation" Text="" Foreground="#8B8B96" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Panel de Desinstalación -->
                <StackPanel x:Name="PanelUninstallOptions" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="¿Estás seguro de que deseas desinstalar Lex Junior Browser de tu equipo?"
                               Foreground="#E4E4E7" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <CheckBox x:Name="ChkDeleteUserData" IsChecked="True" Foreground="#F4F4F5" FontSize="12.5" Margin="0,0,0,10"
                              Content="Borrar también todos los datos de navegación (historial, marcadores, caché y configuración) para dejar la PC 100% limpia"/>
                </StackPanel>
            </Grid>

            <!-- Barra de progreso y estado -->
            <StackPanel Grid.Row="3" Margin="0,8,0,14">
                <TextBlock x:Name="TxtProgressStatus" Text="Listo para continuar" Foreground="#A1A1AA" FontSize="11.5" Margin="0,0,0,6"/>
                <ProgressBar x:Name="ProgressInstall" Height="6" Minimum="0" Maximum="100" Value="0"
                             Background="#1A1A26" Foreground="#6366F1" BorderThickness="0"/>
            </StackPanel>

            <!-- Botones de Acción -->
            <Grid Grid.Row="4">
                <Button x:Name="BtnCancel" Content="Cancelar" HorizontalAlignment="Left"
                        Background="#222230" Foreground="#D4D4D8" FontSize="12" FontWeight="SemiBold"
                        Padding="18,9" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>

                <Button x:Name="BtnPrimaryAction" Content="🚀 Instalar Lex Junior Browser" HorizontalAlignment="Right"
                        Background="#6366F1" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold"
                        Padding="22,9" BorderThickness="0" Cursor="Hand" Click="BtnPrimaryAction_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>


                                               FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PanelWarningBadgeFg}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Cambiaste SmartScreen o detección de phishing después de haberse iniciado el motor WebView2."
                                               FontSize="11" Foreground="{DynamicResource PanelTextBody}" TextWrapping="Wrap" Margin="0,2,0,0"/>

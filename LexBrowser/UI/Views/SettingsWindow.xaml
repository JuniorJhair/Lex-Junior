                                    <TextBlock Text="Trae tus marcadores, historial y contraseñas desde Chrome, Edge, Brave, Opera o archivos CSV." FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>

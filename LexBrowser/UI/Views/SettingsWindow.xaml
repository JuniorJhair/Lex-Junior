                                                <Setter Property="Background" Value="{DynamicResource PanelCardInsetBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelRowHoverBg}"/>
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PanelAccentFg}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelRadioActiveBg}"/>
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PanelAccentBg}"/>
                                                                    <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                        <StackPanel>
                                            <TextBlock Text="Perfil A" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PanelAccentFg}"/>
                                            <TextBlock Text="Privacidad estricta" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PanelTextStrong}" Margin="0,1,0,3"/>
                                            <TextBlock Text="Sin consultas opcionales de seguridad, iconos por C#, sugerencias ni actualizaciones automáticas." FontSize="10.5" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="CardSettingsProfileB" Grid.Column="2" GroupName="SettingsProfileQuickGroup" Click="SettingsProfileCard_Click">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
                                                <Setter Property="Background" Value="{DynamicResource PanelCardInsetBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

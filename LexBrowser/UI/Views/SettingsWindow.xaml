<Window x:Class="LexBrowser.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración - Lex Junior"
        Height="620" Width="820"
        MinHeight="500" MinWidth="680"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F0F14"
        Foreground="#E4E4E7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo CheckBox Toggle moderno -->
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="#2E2E3A" Margin="0,0,0,0">
                                <Ellipse x:Name="thumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barra superior draggable -->
            <RowDefinition Height="42"/>
            <!-- Contenido principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Border Grid.Row="0" Background="#14141A" BorderBrush="#242430" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Configuración de Lex Junior" FontWeight="Bold" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botón cerrar -->
                <Button Grid.Column="2" Content="✕" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="#A1A1AA" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#E11D48"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Cuerpo de configuración -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Menú lateral -->
                <ColumnDefinition Width="210"/>
                <!-- Contenido -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú lateral de navegación -->
            <Border Grid.Column="0" Background="#121217" BorderBrush="#242430" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <TextBlock Text="OPCIONES" FontSize="10.5" FontWeight="Bold" Foreground="#8B8B96" Margin="8,0,0,10"/>
                    
                    <RadioButton x:Name="TabGeneral" Content="🛠️ General" Style="{StaticResource SettingsTabBtn}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabSearch" Content="🔍 Buscador" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabBookmarks" Content="⭐ Accesos Directos" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabTelemetry" Content="🛡️ 0 Telemetría" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>

                    <Border Height="1" Background="#242430" Margin="4,16"/>

                    <Border Background="#1A1A24" CornerRadius="8" Padding="10,12" Margin="0,8">
                        <StackPanel>
                            <TextBlock x:Name="TxtSettingsVersionBadge" Text="⚡ Lex Junior" FontWeight="Bold" FontSize="11" Foreground="#818CF8"/>
                            <TextBlock Text="Navegador ultra-ligero y privado" FontSize="10.5" Foreground="#8B8B96" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Área de contenido con scroll -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="28,20">
                <StackPanel>

                    <!-- SECCIÓN: GENERAL -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                        <TextBlock Text="Funciones de Navegación" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Personaliza los controles y botones activos en tu ventana" FontSize="12" Foreground="#8B8B96" Margin="0,0,0,18"/>

                        <!-- Tarjeta: Navegador Predeterminado -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Navegador Web Predeterminado" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                    <TextBlock x:Name="TxtDefaultBrowserStatus" Text="Comprobando estado en Windows..." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnSetDefaultBrowser" Grid.Column="1" Content="🌐 Establecer como predeterminado" Background="#6366F1" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Padding="14,7" Cursor="Hand" Click="BtnSetDefaultBrowser_Click" VerticalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="7"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkRestoreSession" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Restaurar Pestañas de la Sesión Anterior" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Al abrir el navegador, recupera las pestañas abiertas la última vez con hibernación inteligente (0 MB de RAM hasta hacer clic)" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkFloatingPage" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Botón de Página Flotante" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Muestra el botón '🗖 Página Flotante' en la barra de navegación para desanclar la web completa" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoVideoPip" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Mini-Reproductor de Video Automático (PiP)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Al cambiar de pestaña mientras un video se reproduce (YouTube, partidos en vivo, etc.), flota solo el video" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkAdBlocker" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Escudo Bloqueador de Anuncios y Popunders" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Neutraliza publicidad en video de YouTube, banners molestos y capas invisibles de click-jacking" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkVideoPlayerDefuser" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Desarmador Seguro de Anuncios en Reproductores (JW Player / Fluid)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Intenta saltar cuentas regresivas pre-roll en reproductores de video sin alterar su configuración ni licencia." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkImaSdkStub" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Simulador de Google IMA SDK (ima3.js)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Neutraliza solicitudes publicitarias de video simulando la API de Google IMA. Desactívalo para usar el SDK original de Google si un reproductor presenta incompatibilidad." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkCosmeticShield" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Filtrado Cosmético de Anuncios y Banners" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Oculta espacios publicitarios vacíos y contenedores de banners promocionales para una visualización limpia." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkSubframeWebShield" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Protección Activa en Submarcos e Iframes (WebShield)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Neutraliza popunders, enlaces trampa y comerciales pre-roll dentro de reproductores incrustados y marcos secundarios." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableHistory" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Guardar Historial de Navegación" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Si lo desactivas, el navegador no guardará páginas visitadas y no ocupará espacio en disco." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Height="1" Background="#242430" Margin="0,10,0,10"/>
                                <Grid>
                                    <TextBlock x:Name="TxtSettingsHistoryStorage" Text="Espacio ocupado: Calculando..." FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                    <Button Content="📚 Abrir Gestor de Historial..." HorizontalAlignment="Right" Background="#242436" Foreground="#818CF8" FontSize="11" FontWeight="SemiBold" Padding="12,5" Cursor="Hand" Click="BtnOpenHistoryFromSettings_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="#303048"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🔑 Bóveda de Contraseñas, Bloqueo por PIN y Modo Invitado" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                <TextBlock Text="Guarda tus contraseñas por dominio (.com, .pe, etc.) con 0% consumo de CPU, protege el navegador con PIN y activa el Modo Invitado."
                                           FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                <Grid>
                                    <TextBlock x:Name="TxtSettingsVaultSummary" Text="Contraseñas guardadas: 0" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                    <Button Content="🔑 Abrir Bóveda y Configurar PIN..." HorizontalAlignment="Right" Background="#312E81" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Padding="12,6" BorderThickness="0" Cursor="Hand" Click="BtnOpenVaultFromSettings_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: BUSCADOR -->
                    <StackPanel x:Name="PanelSearch" Visibility="Collapsed">
                        <TextBlock Text="Motor de Búsqueda" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Elige qué buscador usar al escribir consultas en la barra de direcciones" FontSize="12" Foreground="#8B8B96" Margin="0,0,0,24"/>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel>
                                <RadioButton x:Name="RbGoogle" Content="Google (Recomendado - Predeterminado)" GroupName="SearchEngineGroup" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbDuckDuckGo" Content="DuckDuckGo (Búsqueda Privada)" GroupName="SearchEngineGroup" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbBrave" Content="Brave Search (Sin Rastreo)" GroupName="SearchEngineGroup" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbBing" Content="Microsoft Bing" GroupName="SearchEngineGroup" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbCustom" Content="Personalizado" GroupName="SearchEngineGroup" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="URL de búsqueda personalizada (usa %s para el término):" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCustomSearchUrl" Background="#15151D" BorderBrush="#272736" BorderThickness="1" Foreground="#FFFFFF" FontSize="13" Padding="10,8" Margin="0,0,0,16" TextChanged="TxtCustomSearchUrl_TextChanged"/>
                    </StackPanel>

                    <!-- SECCIÓN: ACCESOS DIRECTOS -->
                    <StackPanel x:Name="PanelBookmarks" Visibility="Collapsed">
                        <TextBlock Text="Barra de Accesos Directos" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Gestiona la barra rápida ubicada debajo de la URL" FontSize="12" Foreground="#8B8B96" Margin="0,0,0,24"/>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkBookmarksBar" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Mostrar Barra de Accesos Directos" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Atajo rápido de teclado: presiona Ctrl + Shift + B en cualquier momento para mostrarla u ocultarla" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN ESPECIAL: 0 TELEMETRÍA (EXPLICACIÓN A FONDO) -->
                    <StackPanel x:Name="PanelTelemetry" Visibility="Collapsed">
                        <Border BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="12" Padding="22,18" Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2C1B4D" Offset="0.0"/>
                                    <GradientStop Color="#15151E" Offset="0.8"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Background="#206366F1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="🛡️ MODO BLINDADO ACTIVO" Foreground="#A5B4FC" FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="¿Qué significa '0 Telemetría' en Lex Junior?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Tu navegador corre sin procesos espía corporativos ni fugas de información." FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🔒" FontSize="36" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="¿Para qué sirve y cómo funciona?" FontSize="15" FontWeight="Bold" Foreground="#F4F4F5" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" LineHeight="18" Margin="0,0,0,16">
                            Los navegadores comerciales como Chrome, Edge u Opera tienen decenas de procesos ocultos en segundo plano que envían estadísticas continuas a sus servidores: a qué horas navegas, qué enlaces visitas, pings de latencia, informes de caídas (Breakpad) y telemetría de anuncios.
                            <LineBreak/><LineBreak/>
                            En <Bold Foreground="#818CF8">Lex Junior</Bold>, desactivamos todos estos servicios directamente en el motor Chromium mediante flags nativos de bajo nivel.
                        </TextBlock>

                        <TextBlock Text="🚀 Ventajas Clave:" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                        <Border Background="#15151D" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="✔ Privacidad 100% Local: Ningún dato tuyo sale a servidores de Google u otros." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                                <TextBlock Text="✔ Cero Consumo Silencioso: No hay tareas en segundo plano comiendo tu RAM y batería." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                                <TextBlock Text="✔ Mayor Velocidad: Tu internet se dedica exclusivamente a cargar tus páginas y videos." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                                <TextBlock Text="✔ Sin Perfiles de Rastreo: Flags como InterestCohort / Topics desactivados de raíz." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>

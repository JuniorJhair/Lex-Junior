                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel>
                                <RadioButton x:Name="RbGoogle" Content="Google (Recomendado - Predeterminado)" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbDuckDuckGo" Content="DuckDuckGo (Búsqueda Privada)" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbBrave" Content="Brave Search (Sin Rastreo)" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbBing" Content="Microsoft Bing" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbCustom" Content="Personalizado" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="URL de búsqueda personalizada (usa %s para el término):" FontSize="12" Foreground="{DynamicResource PanelTextMuted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCustomSearchUrl" Style="{StaticResource DarkInput}" FontSize="13" Padding="10,8" Margin="0,0,0,16" TextChanged="TxtCustomSearchUrl_TextChanged"/>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableSearchSuggestions" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Sugerencias de búsqueda en tiempo real" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Muestra sugerencias del motor de búsqueda seleccionado al escribir consultas en la barra de direcciones (no se envían URLs ni direcciones locales). Desactívalo para usar únicamente sugerencias de tu historial local." FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: ACCESOS DIRECTOS -->
                    <StackPanel x:Name="PanelBookmarks" Visibility="Collapsed">
                        <TextBlock Text="Barra de Accesos Directos" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}" Margin="0,0,0,4"/>
                        <TextBlock Text="Gestiona la barra de accesos ubicada debajo de la URL" FontSize="12" Foreground="{DynamicResource PanelTextMuted}" Margin="0,0,0,24"/>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkBookmarksBar" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Mostrar Barra de Accesos Directos" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Atajo de teclado: presiona Ctrl + Shift + B en cualquier momento para mostrarla u ocultarla" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: PRIVACIDAD Y SEGURIDAD (PERFILES Y CONTROLES GRANULARES) -->

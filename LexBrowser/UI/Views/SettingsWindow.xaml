<Window x:Class="LexBrowser.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración - Lex Junior"
        Height="620" Width="820"
        MinHeight="500" MinWidth="680"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F0F14"
        Foreground="#E4E4E7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LexFilterPill" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="Background" Value="#1C1C28"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" BorderBrush="#2D2D3E" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#818CF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alias hacia el Toggle unificado en Theme.xaml -->
        <Style x:Key="ModernToggle" TargetType="CheckBox" BasedOn="{StaticResource LexModernToggle}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barra superior draggable -->
            <RowDefinition Height="42"/>
            <!-- Contenido principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Border Grid.Row="0" Background="#14141A" BorderBrush="#242430" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Configuración de Lex Junior" FontWeight="Bold" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botón cerrar -->
                <Button Grid.Column="2" Content="✕" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="#A1A1AA" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#E11D48"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Cuerpo de configuración -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Menú lateral -->
                <ColumnDefinition Width="210"/>
                <!-- Contenido -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú lateral de navegación -->
            <Border Grid.Column="0" Background="#121217" BorderBrush="#242430" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <TextBlock Text="OPCIONES" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Margin="8,0,0,10"/>
                    
                    <RadioButton x:Name="TabGeneral" Content="🛠️ General" Style="{StaticResource SettingsTabBtn}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabSearch" Content="🔍 Buscador" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabBookmarks" Content="⭐ Accesos Directos" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabNotifications" Content="🔔 Notificaciones" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabTelemetry" Content="🛡️ Sin Telemetría" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>

                    <Border Height="1" Background="#242430" Margin="4,16"/>

                    <Border Background="#1A1A24" CornerRadius="8" Padding="10,12" Margin="0,8">
                        <StackPanel>
                            <TextBlock x:Name="TxtSettingsVersionBadge" Text="⚡ Lex Junior" FontWeight="Bold" FontSize="11" Foreground="#818CF8"/>
                            <TextBlock Text="Navegador ligero y privado" FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Área de contenido con scroll -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="28,20">
                <StackPanel>

                    <!-- SECCIÓN: GENERAL -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                        <TextBlock Text="Funciones de Navegación" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Personaliza los controles y botones activos en tu ventana" FontSize="12" Foreground="#8B8B96" Margin="0,0,0,18"/>

                        <!-- Tarjeta: Navegador Predeterminado -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Navegador Web Predeterminado" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                    <TextBlock x:Name="TxtDefaultBrowserStatus" Text="Comprobando estado en Windows..." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnSetDefaultBrowser" Grid.Column="1" Content="🌐 Establecer como predeterminado"
                                        Style="{StaticResource LexPrimaryButton}" FontSize="12" Padding="14,7"
                                        Click="BtnSetDefaultBrowser_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkRestoreSession" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Restaurar Pestañas de la Sesión Anterior" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Al abrir el navegador, recupera las pestañas abiertas la última vez con hibernación inteligente (solo carga la pestaña activa hasta hacer clic en las demás)" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkFloatingPage" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Botón de Página Flotante" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Muestra el botón '🗖 Página Flotante' en la barra de navegación para desanclar la web completa" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoVideoPip" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Mini-Reproductor de Video Automático (PiP)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Al cambiar de pestaña mientras un video se reproduce (YouTube, partidos en vivo, etc.), flota solo el video" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkAdBlocker" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Escudo Bloqueador de Anuncios y Popunders" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Neutraliza publicidad en video de YouTube, banners molestos y capas invisibles de click-jacking" FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkVideoPlayerDefuser" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Desarmador Seguro de Anuncios en Reproductores (JW Player / Fluid)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Intenta saltar cuentas regresivas pre-roll en reproductores de video sin alterar su configuración ni licencia." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkImaSdkStub" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Simulador de Google IMA SDK (ima3.js)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Neutraliza solicitudes publicitarias de video simulando la API de Google IMA. Desactívalo para usar el SDK original de Google si un reproductor presenta incompatibilidad." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkCosmeticShield" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Filtrado Cosmético de Anuncios y Banners" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Oculta espacios publicitarios vacíos y contenedores de banners promocionales para una visualización limpia." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkSubframeWebShield" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Protección Activa en Submarcos e Iframes (WebShield)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Neutraliza popunders, enlaces trampa y comerciales pre-roll dentro de reproductores incrustados y marcos secundarios." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableHistory" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Guardar Historial de Navegación" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Si lo desactivas, el navegador no guardará páginas visitadas y no ocupará espacio en disco." FontSize="11" Foreground="#8B8B96" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Height="1" Background="#242430" Margin="0,10,0,10"/>
                                <Grid>
                                    <TextBlock x:Name="TxtSettingsHistoryStorage" Text="Espacio ocupado: Calculando..." FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                    <Button Content="📚 Abrir Gestor de Historial..." HorizontalAlignment="Right" Background="#242436" Foreground="#818CF8" FontSize="11" FontWeight="SemiBold" Padding="12,5" Cursor="Hand" Click="BtnOpenHistoryFromSettings_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="#303048"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🔑 Bóveda de Contraseñas, Bloqueo por PIN y Modo Invitado" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                <TextBlock Text="Guarda tus contraseñas por dominio (.com, .pe, etc.) con cifrado DPAPI local, protege el navegador con PIN y activa el Modo Invitado."
                                           FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                <Grid>
                                    <TextBlock x:Name="TxtSettingsVaultSummary" Text="Contraseñas guardadas: 0" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                    <Button Content="🔑 Abrir Bóveda y Configurar PIN..." HorizontalAlignment="Right" Style="{StaticResource LexPrimaryButton}" FontSize="11" FontWeight="Bold" Padding="12,6" Click="BtnOpenVaultFromSettings_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: BUSCADOR -->
                    <StackPanel x:Name="PanelSearch" Visibility="Collapsed">
                        <TextBlock Text="Motor de Búsqueda" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Elige qué buscador usar al escribir consultas en la barra de direcciones" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,24"/>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel>
                                <RadioButton x:Name="RbGoogle" Content="Google (Recomendado - Predeterminado)" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbDuckDuckGo" Content="DuckDuckGo (Búsqueda Privada)" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbBrave" Content="Brave Search (Sin Rastreo)" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbBing" Content="Microsoft Bing" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                                <RadioButton x:Name="RbCustom" Content="Personalizado" Style="{StaticResource LexRadioButton}" GroupName="SearchEngineGroup" FontWeight="SemiBold" Margin="0,6" Click="SaveSearch_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="URL de búsqueda personalizada (usa %s para el término):" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCustomSearchUrl" Style="{StaticResource DarkInput}" FontSize="13" Padding="10,8" Margin="0,0,0,16" TextChanged="TxtCustomSearchUrl_TextChanged"/>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableSearchSuggestions" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Sugerencias de búsqueda en tiempo real" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Muestra sugerencias del motor de búsqueda seleccionado al escribir consultas en la barra de direcciones (no se envían URLs ni direcciones locales). Desactívalo para usar únicamente sugerencias de tu historial local." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: ACCESOS DIRECTOS -->
                    <StackPanel x:Name="PanelBookmarks" Visibility="Collapsed">
                        <TextBlock Text="Barra de Accesos Directos" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Gestiona la barra rápida ubicada debajo de la URL" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,24"/>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkBookmarksBar" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Mostrar Barra de Accesos Directos" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Atajo rápido de teclado: presiona Ctrl + Shift + B en cualquier momento para mostrarla u ocultarla" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN ESPECIAL: SIN TELEMETRÍA PROPIA (EXPLICACIÓN TRANSPARENTE) -->
                    <StackPanel x:Name="PanelTelemetry" Visibility="Collapsed">
                        <Border BorderBrush="#4F46E5" BorderThickness="1.5" CornerRadius="12" Padding="22,18" Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2C1B4D" Offset="0.0"/>
                                    <GradientStop Color="#15151E" Offset="0.8"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Background="#206366F1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="🛡️ PRIVACIDAD Y CONTROL RED" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="¿Qué significa 'Sin Telemetría Propia' en Lex Junior?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="El navegador no incluye analítica, rastreadores propios ni informes automáticos de uso." FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🔒" FontSize="36" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>
                        </Border>

                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableExternalFavicons" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Cargar íconos faltantes de sitios web (Favicons)" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Cuando un sitio de tus marcadores o sugerencias aún no tiene ícono en la caché local en disco, solicita su ícono por dominio público. Desactívalo para no realizar consultas externas de íconos." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="¿Para qué sirve y cómo funciona?" FontSize="15" FontWeight="Bold" Foreground="#F4F4F5" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" LineHeight="18" Margin="0,0,0,16">
                            Muchos navegadores comerciales mantienen servicios en segundo plano que envían métricas de uso, informes de fallos y perfiles publicitarios a sus servidores.
                            <LineBreak/><LineBreak/>
                            En <Bold Foreground="#818CF8">Lex Junior</Bold>, desactivamos estas funciones en el motor Chromium mediante flags nativos y te damos interruptores explícitos sobre las funciones opcionales de red (como sugerencias de búsqueda e íconos de sitios).
                        </TextBlock>

                        <TextBlock Text="🚀 Ventajas Clave:" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                        <Border Background="#15151D" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="✔ Almacenamiento Local: Historial, marcadores y bóveda viven únicamente en tu equipo." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                                <TextBlock Text="✔ Bajo Consumo en Reposo: Sin servicios propios de telemetría ejecutándose en segundo plano." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                                <TextBlock Text="✔ Control Transparente: Puedes desactivar sugerencias de búsqueda e íconos externos cuando quieras." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                                <TextBlock Text="✔ Sin Perfiles Publicitarios: APIs como InterestCohort / Topics y Privacy Sandbox desactivadas." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="⚖️ Aspectos a tener en cuenta:" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                        <Border Background="#15151D" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="• No hay sincronización en la nube (tus marcadores y claves se guardan localmente en tu equipo)." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                                <TextBlock Text="• Si ocurre un error, no se envían reportes automáticos a servidores externos." FontSize="12" Foreground="#E4E4E7" Margin="0,3"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: NOTIFICACIONES WEB (Nivel Senior, sin solapamientos, cuotas y desbloqueo guiado) -->
                    <StackPanel x:Name="PanelNotifications" Visibility="Collapsed">
                        <TextBlock Text="Notificaciones Web y Permisos" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Control granular de alertas por sitio, límites de volumen diario y protección contra saturación" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,18"/>

                        <!-- Tarjeta 1: Política Global de Notificaciones -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Política General de Notificaciones" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5" Margin="0,0,0,4"/>
                                <TextBlock Text="Decide cómo debe actuar Lex Junior cuando un sitio web solicite enviarte alertas" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                                <RadioButton x:Name="RbPolicyAsk" Style="{StaticResource LexRadioButton}" Content="Preguntar a los sitios (Predeterminado: chip discreto 🔔 en la barra)" 
                                             FontSize="12" Margin="0,0,0,8" Checked="PolicyRadio_Checked"/>
                                <RadioButton x:Name="RbPolicyBlockAll" Style="{StaticResource LexRadioButton}" Content="Bloquear todas las solicitudes (Silencio absoluto: las páginas no pueden ni preguntar)" 
                                             FontSize="12" Margin="0,0,0,8" Checked="PolicyRadio_Checked"/>
                                <RadioButton x:Name="RbPolicySilentAll" Style="{StaticResource LexRadioButton}" Content="Permitir solo en modo silencioso (Llegan al centro de avisos sin ventanas emergentes)" 
                                             FontSize="12" Margin="0,0,0,4" Checked="PolicyRadio_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 2: Cuotas y Límites Inteligentes -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Límites Diarios y Cuotas Automáticas" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5" Margin="0,0,0,4"/>
                                <TextBlock Text="Evita la saturación por páginas que envían demasiadas alertas al día. Las cuotas se evalúan al instante cuando llega un aviso." FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,14"/>

                                <!-- Límite Global Diario -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Límite diario acumulado (Todas las páginas combinadas)" FontSize="12" FontWeight="Medium" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Máximo total de alertas emergentes que recibirás al día" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbGlobalDailyLimit" Grid.Column="1" Height="30" SelectionChanged="Limits_SelectionChanged" Style="{StaticResource LexComboBox}">
                                        <ComboBoxItem Content="Sin límite" Tag="0"/>
                                        <ComboBoxItem Content="10 al día" Tag="10"/>
                                        <ComboBoxItem Content="20 al día" Tag="20"/>
                                        <ComboBoxItem Content="30 al día" Tag="30"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Límite Predeterminado por Sitio -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Límite predeterminado por sitio web" FontSize="12" FontWeight="Medium" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Tope diario para cualquier página que no tenga una regla personalizada" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultSiteLimit" Grid.Column="1" Height="30" SelectionChanged="Limits_SelectionChanged" Style="{StaticResource LexComboBox}">
                                        <ComboBoxItem Content="Sin límite" Tag="0"/>
                                        <ComboBoxItem Content="1 al día" Tag="1"/>
                                        <ComboBoxItem Content="2 al día" Tag="2"/>
                                        <ComboBoxItem Content="3 al día" Tag="3"/>
                                        <ComboBoxItem Content="5 al día" Tag="5"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Toggles -->
                                <CheckBox x:Name="ChkDiscardOlder24h" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Descartar notificaciones de más de 24 horas o días anteriores" FontWeight="Medium" FontSize="12" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Si una página envía una alerta desfasada o de una jornada previa, no te interrumpirá en pantalla" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ChkDndFullscreen" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Modo No Molestar en Pantalla Completa o Juegos" FontWeight="Medium" FontSize="12" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Silencia automáticamente cualquier aviso si estás jugando, viendo películas o en presentación (Windows QUNS)" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 3: Sitios Web y Permisos Guardados (Apartado de Bloqueados, Desbloqueo y Personalización) -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sitios Web y Permisos Guardados" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock x:Name="TxtNotificationSitesSummary" Text="Administra permisos, desbloquea páginas y personaliza reglas específicas" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnResetAllSites" Content="Restablecer todos" Style="{StaticResource LexGhostButton}"
                                            FontSize="11" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="BtnResetAllSites_Click" ToolTip="Devolver todos los sitios a estado neutral (Preguntar)"/>
                                </Grid>

                                <!-- Filtros y Buscador -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Botones tipo Pill de filtro -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="FilterAll" Content="Todos" Style="{StaticResource LexFilterPill}" IsChecked="True" Checked="FilterSites_Checked" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="FilterAllowed" Content="Permitidos" Style="{StaticResource LexFilterPill}" Checked="FilterSites_Checked" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="FilterBlocked" Content="Bloqueados" Style="{StaticResource LexFilterPill}" Checked="FilterSites_Checked" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="FilterSilent" Content="Silenciosos" Style="{StaticResource LexFilterPill}" Checked="FilterSites_Checked"/>
                                    </StackPanel>

                                    <!-- Buscador de Dominio -->
                                    <TextBox x:Name="TxtSearchSite" Grid.Column="1" Style="{StaticResource DarkInput}" Height="30" Margin="10,0,0,0" Padding="8,4"
                                             FontSize="11.5" VerticalAlignment="Center" TextChanged="TxtSearchSite_TextChanged"
                                             ToolTip="Filtrar por dominio o nombre de página"/>
                                </Grid>

                                <!-- Contenedor de Lista con Scroll -->
                                <Border Background="#121218" BorderBrush="#22222E" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="160" MaxHeight="340">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <StackPanel x:Name="PanelSitesContainer"/>
                                            <TextBlock x:Name="TxtNoSitesMessage" Text="No hay sitios web configurados en esta categoría."
                                                       Foreground="#A1A1AA" FontSize="11.5" HorizontalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

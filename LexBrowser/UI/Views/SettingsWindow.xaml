                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                        <StackPanel>
                                            <TextBlock Text="Perfil B · Recomendado" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PanelSuccessFg}"/>
                                            <TextBlock Text="Equilibrado" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PanelTextStrong}" Margin="0,1,0,3"/>
                                            <TextBlock Text="SmartScreen e iconos directos del sitio sin Google; avisos de versión bajo confirmación." FontSize="10.5" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap"/>

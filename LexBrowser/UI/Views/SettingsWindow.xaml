                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Background="{DynamicResource PanelTelemetryPillBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="🛡️ PRIVACIDAD Y SEGURIDAD" Foreground="{DynamicResource PanelTelemetryPillFg}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="¿Qué significa 'Sin Telemetría Propia' en Lex Junior?" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}"/>
                                    <TextBlock Text="Lex Junior no incorpora telemetría propia. Las conexiones con servicios externos dependen de las funciones que actives." FontSize="12" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🔒" FontSize="36" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>
                        </Border>


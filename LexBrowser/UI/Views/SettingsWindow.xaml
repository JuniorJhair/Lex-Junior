<Window x:Class="LexBrowser.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LexBrowser.UI.Controls"
        Title="Configuración - Lex Junior"
        Height="640" Width="1040"
        MinHeight="520" MinWidth="860"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource PanelWindowBg}"
        Foreground="{DynamicResource PanelTextBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PanelTextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PanelTabHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PanelTextStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PanelTabActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PanelAccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LexFilterPill" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource PanelFilterPillBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PanelTextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource PanelFilterPillBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource PanelTabHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PanelTextStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource PanelAccentBg}"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource PanelAccentFg}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DefaultBrowserBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource PanelAccentBg}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelAccentHoverBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aliases hacia los estilos dinámicos tematizables de Theme.xaml -->
        <Style x:Key="ModernToggle" TargetType="CheckBox" BasedOn="{StaticResource LexThemedToggle}"/>
        <Style x:Key="LexComboBox" TargetType="ComboBox" BasedOn="{StaticResource LexThemedComboBox}"/>
        <Style x:Key="LexComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource LexThemedComboItem}"/>
        <Style x:Key="LexRadioButton" TargetType="RadioButton" BasedOn="{StaticResource LexThemedRadioButton}"/>
        <Style x:Key="DarkInput" TargetType="TextBox" BasedOn="{StaticResource LexThemedInput}"/>
        <Style x:Key="LexSecondaryButton" TargetType="Button" BasedOn="{StaticResource LexThemedSecondaryButton}"/>
        <Style x:Key="LexGhostButton" TargetType="Button" BasedOn="{StaticResource LexThemedGhostButton}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource LexThemedComboBox}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource LexThemedComboItem}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource LexThemedScrollBar}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barra superior draggable -->
            <RowDefinition Height="42"/>
            <!-- Contenido principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Border Grid.Row="0" Background="{DynamicResource PanelChromeBg}" BorderBrush="{DynamicResource PanelBorderSubtle}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Configuración de Lex Junior" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PanelTextSoft}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botón cerrar -->
                <Button Grid.Column="2" Content="✕" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource PanelTextMuted}" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#E11D48"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Cuerpo de configuración -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Menú lateral -->
                <ColumnDefinition Width="210"/>
                <!-- Contenido -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú lateral de navegación -->
            <Border Grid.Column="0" Background="{DynamicResource PanelSidebarBg}" BorderBrush="{DynamicResource PanelBorderSubtle}" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <TextBlock Text="OPCIONES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PanelTextMuted}" Margin="8,0,0,10"/>
                    
                    <RadioButton x:Name="TabGeneral" Content="🛠️ General" Style="{StaticResource SettingsTabBtn}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabSearch" Content="🔍 Buscador" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabBookmarks" Content="⭐ Accesos Directos" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabNotifications" Content="🔔 Notificaciones" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabTelemetry" Content="🛡️ Privacidad y seguridad" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabAboutLicenses" Content="📜 Licencias y créditos" Style="{StaticResource SettingsTabBtn}" Checked="Tab_Checked"/>

                    <Border Height="1" Background="{DynamicResource PanelBorderSubtle}" Margin="4,16"/>

                    <Border Background="{DynamicResource PanelCardSubtleBg}" BorderBrush="{DynamicResource PanelBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,12" Margin="0,8">
                        <StackPanel>
                            <TextBlock x:Name="TxtSettingsVersionBadge" Text="⚡ Lex Junior" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PanelAccentFg}"/>
                            <TextBlock Text="Sin telemetría propia · Menos anuncios · Privado" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Área de contenido con scroll -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="28,20">
                <StackPanel>

                    <!-- Aviso visible mientras AutoSavesSuspended siga activo tras settings.json ilegible -->
                    <Border x:Name="BorderSettingsSavesSuspended"
                            Background="{DynamicResource PanelWarningBadgeBg}"
                            BorderBrush="{DynamicResource PanelWarningBadgeFg}"
                            BorderThickness="1.2"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="⚠️ Guardado automático pausado (modo de recuperación)"
                                           FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PanelWarningBadgeFg}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtSettingsSavesSuspendedDetail"
                                           Text="Los cambios realizados no se escribirán en disco hasta que autorices continuar con la configuración recuperada."
                                           FontSize="11.5" Foreground="{DynamicResource PanelTextBody}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnSettingsContinueRecovered" Grid.Column="1" Content="Continuar con lo recuperado"
                                    Click="BtnSettingsContinueRecovered_Click"
                                    Style="{StaticResource DefaultBrowserBtnStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- SECCIÓN: GENERAL -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                        <TextBlock Text="Funciones de Navegación" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}" Margin="0,0,0,4"/>
                        <TextBlock Text="Personaliza los controles y botones activos en tu ventana" FontSize="12" Foreground="{DynamicResource PanelTextSubtle}" Margin="0,0,0,18"/>

                        <!-- Tarjeta: Tema Visual del Navegador -->
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="🎨 Tema Visual del Navegador" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                    <TextBlock Text="Elige la apariencia para la ventana, pestañas, barra de navegación y páginas del sistema." FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbBrowserTheme" Grid.Column="1" Width="175" Height="30" VerticalAlignment="Center"
                                          SelectionChanged="CmbBrowserTheme_SelectionChanged">
                                    <ComboBoxItem Content="⚡ Clásico (Original)" Tag="Classic"/>
                                    <ComboBoxItem Content="🌙 Oscuro" Tag="Dark"/>
                                    <ComboBoxItem Content="☀️ Claro" Tag="Light"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Tarjeta: Navegador Predeterminado -->
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Navegador Web Predeterminado" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                    <TextBlock x:Name="TxtDefaultBrowserStatus" Text="Comprobando estado en Windows..." FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnSetDefaultBrowser" Grid.Column="1" Content="🌐 Establecer como predeterminado"
                                        Style="{StaticResource DefaultBrowserBtnStyle}"
                                        Click="BtnSetDefaultBrowser_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkRestoreSession" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Restaurar Pestañas de la Sesión Anterior" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Al abrir el navegador, recupera las pestañas abiertas la última vez con hibernación inteligente (solo carga la pestaña activa hasta hacer clic en las demás)" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkFloatingPage" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Botón de Página Flotante" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Muestra el botón '🗖 Página Flotante' en la barra de navegación para desanclar la web completa" FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoVideoPip" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Mini-Reproductor de Video Automático (PiP)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Al cambiar de pestaña mientras un video se reproduce (YouTube, partidos en vivo, etc.), flota solo el video" FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkAdBlocker" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Escudo Maestro Bloqueador de Anuncios y Popunders (LexShield)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Neutraliza publicidad en video de YouTube y Dailymotion, banners molestos y capas invisibles de click-jacking. Puedes ajustar cada sitio desde el icono 🛡️ de la barra de direcciones." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="PanelAdBlockSubModules">
                            <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkImaSdkStub" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                        <StackPanel>
                                            <TextBlock Text="Adaptador de Google IMA SDK y Stubs VAST/VMAP (ima3.js)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                            <TextBlock Text="Neutraliza solicitudes publicitarias de video adaptando la interfaz de Google IMA. Desactívalo para usar el SDK original de Google si un reproductor presenta incompatibilidad." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCosmeticShield" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                        <StackPanel>
                                            <TextBlock Text="Filtrado Cosmético de Anuncios y Banners" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                            <TextBlock Text="Oculta espacios publicitarios vacíos y contenedores de banners promocionales para una visualización limpia." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkYouTubeAdBlock" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                        <StackPanel>
                                            <TextBlock Text="Bloqueador de Anuncios en YouTube (Módulo Aislado)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                            <TextBlock Text="Elimina anuncios de video, Shorts patrocinados y espacios publicitarios en YouTube con el módulo aislado antes de que carguen en el reproductor, sin alterar la velocidad ni el audio." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkVideoPlayerDefuser" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                        <StackPanel>
                                            <TextBlock Text="Desarmador Pasivo en Reproductores Externos (Respaldo)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                            <TextBlock Text="Respaldo opcional para reproductores JW Player, Video.js y Fluid Player cuando un bloqueo pausa la reproducción; desactivado por defecto en sitios generales y aislado de YouTube y Dailymotion." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSubframeWebShield" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                        <StackPanel>
                                            <TextBlock Text="Protección de Escudo en Submarcos e Iframes (LexShield Core)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                            <TextBlock Text="Aplica bloqueo declarativo, scriptlets y defensa cosmética también dentro de submarcos e iframes embebidos (respeta pasarelas de pago, SSO, YouTube y Dailymotion)." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkDiagnosticMode" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                        <StackPanel>
                                            <TextBlock Text="Modo Diagnóstico Verboso de LexShield" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                            <TextBlock Text="Registra también peticiones permitidas y navegaciones en memoria (Ctrl+Shift+L para guardar el registro en la carpeta Logs del navegador). Jamás registra pestañas de Incógnito ni Modo Invitado." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableHistory" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Guardar Historial de Navegación" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Si lo desactivas, el navegador no guardará páginas visitadas y no ocupará espacio en disco." FontSize="11" Foreground="{DynamicResource PanelTextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Height="1" Background="{DynamicResource PanelBorderSubtle}" Margin="0,10,0,10"/>
                                <Grid>
                                    <TextBlock x:Name="TxtSettingsHistoryStorage" Text="Espacio ocupado: Calculando..." FontSize="11" Foreground="{DynamicResource PanelTextMuted}" VerticalAlignment="Center"/>
                                    <Button Content="📚 Abrir Gestor de Historial..." HorizontalAlignment="Right" Background="{DynamicResource PanelHistoryBtnBg}" Foreground="{DynamicResource PanelAccentFg}" FontSize="11" FontWeight="SemiBold" Padding="12,5" Cursor="Hand" Click="BtnOpenHistoryFromSettings_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHistoryBtnHoverBg}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta: Descargas -->
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⬇️ Descargas" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PanelTextPrimary}" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkAskWhereToSaveDownloads" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>

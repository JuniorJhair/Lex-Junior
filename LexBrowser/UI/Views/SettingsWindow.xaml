                                                <Setter Property="Background" Value="{DynamicResource PanelCardInsetBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelRowHoverBg}"/>
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PanelAccentFg}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelRadioActiveBg}"/>
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PanelAccentBg}"/>
                                                                    <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                        <StackPanel>
                                            <TextBlock Text="Perfil C" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PanelAccentFg}"/>
                                            <TextBlock Text="Completo" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PanelTextStrong}" Margin="0,1,0,3"/>
                                            <TextBlock Text="Todas las ayudas activadas: SmartScreen, detección de phishing, Google Favicons, sugerencias y avisos." FontSize="10.5" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <TextBlock Text="Si modificas cualquier interruptor individual abajo, el perfil pasa automáticamente a «Personalizado» sin alterar el resto de tus opciones."
                                           FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Controles individuales compartidos con la tarjeta D -->
                        <TextBlock Text="Opciones individuales" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PanelTextPrimary}" Margin="0,0,0,8"/>
                        <controls:PrivacyOptionsPanelControl x:Name="PrivacySettingsOptionsPanel" Margin="0,0,0,16"/>

                        <TextBlock Text="¿Para qué sirve y cómo funciona?" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PanelTextPrimary}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource PanelTextMuted}" FontSize="12" LineHeight="18" Margin="0,0,0,16">
                            Muchos navegadores comerciales mantienen servicios en segundo plano que envían métricas de uso, informes de fallos y perfiles publicitarios a sus servidores.
                            <LineBreak/><LineBreak/>
                            En <Bold Foreground="{DynamicResource PanelAccentFg}">Lex Junior</Bold>, no recopilamos ni enviamos telemetría propia. Además reducimos servicios de fondo innecesarios en Chromium y te damos el control de cada función con conexión externa (seguridad, favicons en caché RAM en memoria, sugerencias de búsqueda y actualizaciones). Las páginas que visites y el motor WebView2 siguen generando su propio tráfico normal.
                        </TextBlock>

                        <TextBlock Text="🚀 Características verificadas:" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PanelSuccessFg}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorderMuted}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="✔ Almacenamiento Local: Historial, marcadores y bóveda cifrada DPAPI viven únicamente en tu equipo." FontSize="12" Foreground="{DynamicResource PanelTextBody}" Margin="0,3"/>
                                <TextBlock Text="✔ Sin Telemetría Propia: Lex Junior no envía analítica de uso ni reportes automáticos a un servidor del autor." FontSize="12" Foreground="{DynamicResource PanelTextBody}" Margin="0,3"/>
                                <TextBlock Text="✔ Caché de Favicons en Memoria RAM: Los iconos resueltos permanecen solo en RAM durante la sesión (no se escriben en caché local de favicons en disco)." FontSize="12" Foreground="{DynamicResource PanelTextBody}" Margin="0,3" TextWrapping="Wrap"/>
                                <TextBlock Text="✔ Sin Perfiles Publicitarios: APIs como InterestCohort / Topics y Google Translate automático en segundo plano desactivadas." FontSize="12" Foreground="{DynamicResource PanelTextBody}" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="⚖️ Aspectos a tener en cuenta:" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PanelWarningFg}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorderMuted}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="• No hay sincronización en la nube (tus marcadores y claves se guardan localmente en tu equipo)." FontSize="12" Foreground="{DynamicResource PanelTextBody}" Margin="0,3"/>
                                <TextBlock Text="• Activar Google Favicons, sugerencias en vivo, SmartScreen o detección de phishing realiza consultas externas hacia los proveedores correspondientes." FontSize="12" Foreground="{DynamicResource PanelTextBody}" Margin="0,3" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: NOTIFICACIONES WEB (Nivel Senior, sin solapamientos, cuotas y desbloqueo guiado) -->
                    <StackPanel x:Name="PanelNotifications" Visibility="Collapsed">
                        <TextBlock Text="Notificaciones Web y Permisos" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}" Margin="0,0,0,4"/>
                        <TextBlock Text="Control granular de alertas por sitio, límites de volumen diario y protección contra saturación" FontSize="12" Foreground="{DynamicResource PanelTextMuted}" Margin="0,0,0,18"/>

                        <!-- Tarjeta 1: Política Global de Notificaciones -->
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Política General de Notificaciones" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="Decide cómo debe actuar Lex Junior cuando un sitio web solicite enviarte alertas" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" Margin="0,0,0,12"/>

                                <RadioButton x:Name="RbPolicyAsk" Style="{StaticResource LexRadioButton}" Content="Preguntar a los sitios (Predeterminado: chip discreto 🔔 en la barra)" 
                                             FontSize="12" Margin="0,0,0,8" Checked="PolicyRadio_Checked"/>
                                <RadioButton x:Name="RbPolicyBlockAll" Style="{StaticResource LexRadioButton}" Content="Bloquear todas las solicitudes (Silencio absoluto: las páginas no pueden ni preguntar)" 
                                             FontSize="12" Margin="0,0,0,8" Checked="PolicyRadio_Checked"/>
                                <RadioButton x:Name="RbPolicySilentAll" Style="{StaticResource LexRadioButton}" Content="Permitir solo en modo silencioso (Llegan al centro de avisos sin ventanas emergentes)" 
                                             FontSize="12" Margin="0,0,0,4" Checked="PolicyRadio_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 2: Cuotas y Límites Inteligentes -->
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Límites Diarios y Cuotas Automáticas" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="Evita la saturación por páginas que envían demasiadas alertas al día. Las cuotas se evalúan al instante cuando llega un aviso." FontSize="11" Foreground="{DynamicResource PanelTextMuted}" Margin="0,0,0,14"/>

                                <!-- Límite Global Diario -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Límite diario acumulado (Todas las páginas combinadas)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Máximo total de alertas emergentes que recibirás al día" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbGlobalDailyLimit" Grid.Column="1" Height="30" SelectionChanged="Limits_SelectionChanged" Style="{StaticResource LexComboBox}">
                                        <ComboBoxItem Content="Sin límite" Tag="0"/>
                                        <ComboBoxItem Content="10 al día" Tag="10"/>
                                        <ComboBoxItem Content="20 al día" Tag="20"/>
                                        <ComboBoxItem Content="30 al día" Tag="30"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Límite Predeterminado por Sitio -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Límite predeterminado por sitio web" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Tope diario para cualquier página que no tenga una regla personalizada" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultSiteLimit" Grid.Column="1" Height="30" SelectionChanged="Limits_SelectionChanged" Style="{StaticResource LexComboBox}">
                                        <ComboBoxItem Content="Sin límite" Tag="0"/>
                                        <ComboBoxItem Content="1 al día" Tag="1"/>
                                        <ComboBoxItem Content="2 al día" Tag="2"/>
                                        <ComboBoxItem Content="3 al día" Tag="3"/>
                                        <ComboBoxItem Content="5 al día" Tag="5"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Toggles -->
                                <CheckBox x:Name="ChkDiscardOlder24h" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Descartar notificaciones de más de 24 horas o días anteriores" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Si una página envía una alerta desfasada o de una jornada previa, no te interrumpirá en pantalla" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ChkDndFullscreen" Style="{StaticResource ModernToggle}" Click="SaveSettings_Click">
                                    <StackPanel>
                                        <TextBlock Text="Modo No Molestar en Pantalla Completa o Juegos" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Silencia automáticamente cualquier aviso si estás jugando, viendo películas o en presentación (Windows QUNS)" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 3: Sitios Web y Permisos Guardados (Apartado de Bloqueados, Desbloqueo y Personalización) -->
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sitios Web y Permisos Guardados" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock x:Name="TxtNotificationSitesSummary" Text="Administra permisos, desbloquea páginas y personaliza reglas específicas" FontSize="11" Foreground="{DynamicResource PanelTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnResetAllSites" Content="Restablecer todos" Style="{StaticResource LexGhostButton}"
                                            FontSize="11" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="BtnResetAllSites_Click" ToolTip="Devolver todos los sitios a estado neutral (Preguntar)"/>
                                </Grid>

                                <!-- Filtros y Buscador -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Botones tipo Pill de filtro -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="FilterAll" Content="Todos" Style="{StaticResource LexFilterPill}" IsChecked="True" Checked="FilterSites_Checked" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="FilterAllowed" Content="Permitidos" Style="{StaticResource LexFilterPill}" Checked="FilterSites_Checked" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="FilterBlocked" Content="Bloqueados" Style="{StaticResource LexFilterPill}" Checked="FilterSites_Checked" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="FilterSilent" Content="Silenciosos" Style="{StaticResource LexFilterPill}" Checked="FilterSites_Checked"/>
                                    </StackPanel>

                                    <!-- Buscador de Dominio -->
                                    <TextBox x:Name="TxtSearchSite" Grid.Column="1" Style="{StaticResource DarkInput}" Height="30" Margin="10,0,0,0" Padding="8,4"
                                             FontSize="11.5" VerticalAlignment="Center" TextChanged="TxtSearchSite_TextChanged"
                                             ToolTip="Filtrar por dominio o nombre de página"/>
                                </Grid>

                                <!-- Contenedor de Lista con Scroll -->
                                <Border Background="{DynamicResource PanelCardInsetBg}" BorderBrush="{DynamicResource PanelBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="160" MaxHeight="340">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <StackPanel x:Name="PanelSitesContainer"/>
                                            <TextBlock x:Name="TxtNoSitesMessage" Text="No hay sitios web configurados en esta categoría."
                                                       Foreground="{DynamicResource PanelTextMuted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: ACERCA DE, LICENCIAS Y CRÉDITOS -->
                    <StackPanel x:Name="PanelAboutLicenses" Visibility="Collapsed">
                        <TextBlock Text="Licencias, Créditos y Acerca de" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}" Margin="0,0,0,4"/>
                        <TextBlock Text="Información de versión, atribución de LexShield Core y avisos legales de código abierto" FontSize="12" Foreground="{DynamicResource PanelTextMuted}" Margin="0,0,0,18"/>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtAboutProductTitle" Text="Lex Junior Browser · Junior Pacherrez · LexShield Core" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PanelTextPrimary}"/>
                                <TextBlock x:Name="TxtAboutSummary" Text="Creado por Junior Pacherrez. Navegador de escritorio privado sin telemetría propia, con motor unificado LexShield Core para navegar con menos anuncios y módulos aislados para YouTube y Dailymotion." FontSize="11.5" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Avisos de Terceros y Licencias (THIRD_PARTY_NOTICES.txt)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PanelTextPrimary}"/>
                                        <TextBlock Text="Copyright © 2026 Junior Pacherrez · Incluye atribuciones oficiales de WebView2 SDK, PDF.js, pdf-lib, hls.js, mpegts.js, SQLite, System.Speech y recursos de lex-shield.lex." FontSize="11" Foreground="{DynamicResource PanelTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnOpenNoticesFile" Content="📂 Abrir archivo" Style="{StaticResource LexSecondaryButton}"
                                            FontSize="11" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="BtnOpenNoticesFile_Click"/>
                                </Grid>

                                <TextBox x:Name="TxtThirdPartyNotices" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         Height="320" Padding="10" FontFamily="Consolas" FontSize="11"
                                         Background="{DynamicResource PanelSurfaceDeepBg}" Foreground="{DynamicResource PanelTextSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                         AcceptsReturn="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

                        </Border>

                        <!-- Bloque: Perfil de privacidad y seguridad (7.2) -->
                        <Border Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Perfil de privacidad y seguridad" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border x:Name="BorderSettingsActiveProfileBadge" Background="{DynamicResource PanelTelemetryPillBg}" CornerRadius="6" Padding="9,3">
                                                <TextBlock x:Name="TxtSettingsActiveProfileBadge" Text="Perfil activo: Perfil B — Equilibrado" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PanelTelemetryPillFg}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="BtnOpenProfileComparison" Grid.Column="1" Content="📊 Ver comparativa de perfiles…"
                                            Style="{StaticResource LexSecondaryButton}" Padding="12,6" VerticalAlignment="Center"
                                            Click="BtnOpenProfileComparison_Click"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


<Window x:Class="LexBrowser.UI.Views.UpdatePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualización disponible — Lex Junior Browser"
        Width="640"
        MinWidth="520"
        MaxWidth="700"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelWindowBg}"
        Foreground="{DynamicResource PanelTextBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="4" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="UpdatePrimaryBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource PanelAccentBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PanelOnAccentFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelAccentHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource LexThemedScrollBar}"/>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="{DynamicResource PanelChromeBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Actualización de Lex Junior Browser" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Grid.Column="1" Content="✕" Click="BtnLater_Click" Width="34" Height="30"
                            WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource PanelTextMuted}" FontSize="13" Cursor="Hand" ToolTip="Cerrar ventana">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelCloseHoverBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PanelCloseHoverFg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Cabecera de versión -->
            <Border Grid.Row="1" Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorderSubtle}"
                    BorderThickness="0,0,0,1" Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Margin="0,0,14,0"
                            Background="{DynamicResource PanelCardSubtleBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="30" Height="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeadline" Text="¡Nueva versión lista para instalar!"
                                       FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PanelTextStrong}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Tus marcadores, historial, bóveda PIN y perfiles de privacidad se conservarán intactos."
                                   FontSize="11.8" Foreground="{DynamicResource PanelTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource PanelSuccessBadgeBg}" BorderBrush="{DynamicResource PanelSuccessBadgeFg}"
                            BorderThickness="1" CornerRadius="8" Padding="11,6" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtVersionBadge" Text="v2.6.0 ➔ v2.7.0"
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PanelSuccessBadgeFg}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Notas de la versión formateadas con ScrollViewer -->
            <Border Grid.Row="2" Padding="22,14,22,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NOVEDADES Y MEJORAS DE ESTA ACTUALIZACIÓN"
                                   FontSize="10.8" FontWeight="Bold" Foreground="{DynamicResource PanelTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtIntegrityBadge" Grid.Column="1" Text="🔒 Instalador verificado con SHA-256"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PanelAccentFg}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource PanelCardSubtleBg}" BorderBrush="{DynamicResource PanelBorderSubtle}"
                            BorderThickness="1" CornerRadius="10" Padding="4">
                        <ScrollViewer x:Name="NotesScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="320"
                                      MinHeight="170"
                                      Padding="14,10"
                                      PreviewMouseWheel="NotesScrollViewer_PreviewMouseWheel">
                            <StackPanel x:Name="NotesContainer"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Barra de progreso de descarga (oculta hasta pulsar Actualizar) -->
            <Border x:Name="DownloadProgressPanel" Grid.Row="3" Visibility="Collapsed"
                    Margin="22,0,22,12" Padding="14,10" CornerRadius="9"
                    Background="{DynamicResource PanelCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtDownloadStatus" Text="Descargando actualización..."
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextStrong}"/>
                        <TextBlock x:Name="TxtDownloadPercent" Grid.Column="1" Text="0%"
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PanelAccentFg}"/>
                    </Grid>
                    <ProgressBar x:Name="BarDownloadProgress" Minimum="0" Maximum="100" Value="0" Height="7"
                                 Background="{DynamicResource PanelCardSubtleBg}" Foreground="{DynamicResource PanelAccentBg}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Botones inferiores -->
            <Border Grid.Row="4" Background="{DynamicResource PanelChromeBg}" BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnViewOnGitHub" Grid.Column="0" Content="🌐 Ver en GitHub" Click="BtnViewOnGitHub_Click"
                            Style="{StaticResource LexSecondaryButton}" Padding="12,8"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnLater" Content="Ahora no" Click="BtnLater_Click"
                                Style="{StaticResource LexSecondaryButton}" Padding="14,8" Margin="0,0,10,0" IsCancel="True"/>
                        <Button x:Name="BtnInstallNow" Content="🚀 Actualizar e instalar ahora" Click="BtnInstallNow_Click"
                                Style="{StaticResource UpdatePrimaryBtnStyle}" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

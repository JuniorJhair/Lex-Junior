<Window x:Class="LexBrowser.UI.Views.LexClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lex Junior Class"
        Icon="pack://application:,,,/Assets/lexclass.ico"
        Width="1120" Height="700"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#090B14"
        Foreground="#F4F4F5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <LinearGradientBrush x:Key="LexClassHeaderAccent" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF6B00" Offset="0"/>
            <GradientStop Color="#9333EA" Offset="0.65"/>
            <GradientStop Color="#38BDF8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="HeaderToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B1F30"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#2D334D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262C44"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FB923C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313957"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionWinBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionWinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="ClassWindowChrome" CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="RowHeader" Height="42"/>
            <RowDefinition x:Name="RowAccentLine" Height="1.5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior limpia (SIN URL / Omnibox / Historial) -->
        <Border Grid.Row="0" Background="#0E111D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Identidad Lex Junior Class -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="24" Height="24" Margin="0,0,9,0" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/lexclass.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Lex Junior Class" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border CornerRadius="6" Padding="7,2" Background="#26FF6B00" BorderBrush="#77FF6B00" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="PROTOTIPO" FontSize="9.5" FontWeight="ExtraBold" Foreground="#FDBA74" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="6" Padding="7,2" Background="#1E1B4B" BorderBrush="#4F46E5" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPackSyncStatus" Text="100% Local" FontSize="10" FontWeight="SemiBold" Foreground="#C4B5FD" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>

                <!-- Controles propios (Actualizar mundos + Pantalla completa + Ventana) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnCheckWorlds" Style="{StaticResource HeaderToolBtn}"
                            Margin="0,0,6,0"
                            ToolTip="Comprobar si existen mundos nuevos o actualizaciones disponibles (requiere internet)"
                            Click="BtnCheckWorlds_Click">
                        <TextBlock x:Name="TxtCheckWorldsLabel" Text="🔄 Buscar actualizaciones"/>
                    </Button>

                    <Button x:Name="BtnFullScreen" Style="{StaticResource HeaderToolBtn}"
                            Margin="0,0,8,0"
                            ToolTip="Alternar pantalla completa (F11 · Esc para salir)"
                            Click="BtnFullScreen_Click">
                        <TextBlock x:Name="TxtFullScreenBtnLabel" Text="⛶ Pantalla completa"/>
                    </Button>

                    <Button Style="{StaticResource CaptionWinBtn}" Content="─" Click="BtnMinimize_Click" ToolTip="Minimizar"/>
                    <Button x:Name="BtnMaxRestore" Style="{StaticResource CaptionWinBtn}" Content="□" Click="BtnMaximize_Click" ToolTip="Maximizar / Restaurar"/>
                    <Button Style="{StaticResource CaptionCloseBtn}" Content="✕" Click="BtnClose_Click" ToolTip="Cerrar Lex Junior Class"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Línea de acento inferior del header -->
        <Border Grid.Row="1" Background="{StaticResource LexClassHeaderAccent}" Opacity="0.72"/>

        <!-- Contenido WebView2 aislado para Lex Junior Class -->
        <Grid Grid.Row="2" Background="#090B14">
            <wv2:WebView2 x:Name="ClassWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Pantalla inicial mientras carga la interfaz de Lex Junior Class -->
            <Border x:Name="LoadingOverlay" Background="#090B14" Panel.ZIndex="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="22" Width="88" Height="88" Margin="0,0,0,16" ClipToBounds="True"
                            BorderBrush="#66FF6B00" BorderThickness="1.5" Background="#161426">
                        <Image Source="pack://application:,,,/Assets/lexclass.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Lex Junior Class" FontSize="20" FontWeight="ExtraBold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLoadingSubtitle" Text="Cargando academia local interactiva..." FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Botón flotante X arriba al centro en pantalla completa (Airspace-safe sobre WebView2) -->
        <Popup x:Name="PopupFullScreenExit"
               PlacementTarget="{Binding ElementName=RootLayoutGrid}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border x:Name="FullScreenExitCard"
                    Margin="16,12,16,16"
                    Width="44" Height="44"
                    CornerRadius="22"
                    Background="#E6101322"
                    BorderBrush="#77FB923C"
                    BorderThickness="1.2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#000000" Opacity="0.72"/>
                </Border.Effect>
                <Button x:Name="BtnExitFullScreen"
                        Style="{StaticResource HeaderToolBtn}"
                        Content="✕"
                        Width="42" Height="42"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#F8FAFC"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnExitFullScreen_Click"
                        ToolTip="Salir de pantalla completa (F11 / Esc)"
                        AutomationProperties.Name="Salir de pantalla completa"/>
            </Border>
        </Popup>
    </Grid>
</Window>

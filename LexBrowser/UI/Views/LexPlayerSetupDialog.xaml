<Window x:Class="LexBrowser.UI.Views.LexPlayerSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lex Player APK — Reproductor Android de Streaming"
        Icon="pack://application:,,,/Assets/logo.png"
        Width="540" Height="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#0F131F" BorderBrush="#2E4A78" BorderThickness="1.5" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#12233E" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="12" Width="46" Height="46" Margin="0,0,12,0">
                        <TextBlock Text="📱" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LEX PLAYER APK" FontSize="17" FontWeight="Black" Foreground="#F8FAFC"/>
                            <Border Background="#132944" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SOLO STREAMING" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Motor Android limpio externo optimizado para apps de video (.apk / .xapk)"
                                   FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30"
                        Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="BtnClose_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="#131B2E" BorderBrush="#233354" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Antes de instalar Lex Junior Player:" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                    <TextBlock Text="• Diseñado exclusivamente para APKs de streaming (Magma, Streamflix, Kodi, etc.), sin Play Store ni anuncios."
                               FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="• Su asistente revisará primero tu PC: si ya tienes Android SDK, Platform-Tools, Emulator o Build-Tools al día, NO los vuelve a instalar."
                               FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="• Si algún componente falta o está desactualizado, te avisará y lo instalará automáticamente."
                               FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="• También podrás elegir si deseas crear el icono de Lex Junior Player en tu Escritorio."
                               FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock x:Name="TxtStatus" Text="Listo para descargar e iniciar el instalador de Lex Junior Player."
                           FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <ProgressBar x:Name="BarProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                             Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
            </StackPanel>

            <Grid Grid.Row="3">
                <Button x:Name="BtnCancel" Content="Ahora no" HorizontalAlignment="Left" Padding="16,9"
                        Background="#1E293B" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnClose_Click"/>
                <Button x:Name="BtnInstall" Content="⬇ Descargar e Instalar Lex Player" HorizontalAlignment="Right" Padding="20,9"
                        Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontSize="12.5" FontWeight="Bold"
                        Cursor="Hand" Click="BtnInstall_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="LexBrowser.UI.Views.FloatingPipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Página Flotante" 
        Height="360" Width="600"
        MinHeight="100" MinWidth="160"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0D0D12"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Botón icónico PiP -->
        <Style x:Key="PipIconBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="#33FF2222"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEFF3344"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para el Slider personalizado -->
        <Style x:Key="PipSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#6366F1"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="13" Height="13" Fill="#FFFFFF" Margin="0,-4,0,-4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#3A3A4A"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#111116" BorderBrush="#2A2A38" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Barra de título draggable -->
                <RowDefinition Height="36"/>
                <!-- Contenedor de la página web completa (WebView2 se inserta aquí de borde a borde) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── BARRA DE TÍTULO ─── -->
            <Border Grid.Row="0" Background="#0D0D12" BorderBrush="#2A2A38" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Badge -->
                    <Border Grid.Column="0" Background="#1E1E6A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPipBadge" Text="🗖 Página Flotante" Foreground="#818CF8" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <!-- Título de la página / video -->
                    <TextBlock x:Name="TxtHeaderTitle" Grid.Column="1" Text="Página Flotante" 
                               Foreground="#D4D4D8" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <!-- Menú de Tamaños Preset -->
                    <Button x:Name="BtnSizePresets" Grid.Column="2" Style="{StaticResource PipIconBtn}" 
                            ToolTip="Elegir tamaño de ventana rápido (Compacto, Grande, Shorts o Pantalla Completa)"
                            Click="BtnSizePresets_Click" Margin="0,0,5,0" Padding="7,3"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="📐 Tamaño ▾" FontSize="10" FontWeight="Bold" Foreground="#A78BFA"/>
                        <Button.ContextMenu>
                            <ContextMenu Background="#1A1A24" BorderBrush="#2A2A38" Foreground="#FFFFFF">
                                <MenuItem Header="📱 Shorts / Vertical (420 × 740)" Click="PresetSize_Click" Tag="420x740"/>
                                <MenuItem Header="🗖 Compacto (480 × 270)" Click="PresetSize_Click" Tag="480x270"/>
                                <MenuItem Header="🗖 Mediano (720 × 405)" Click="PresetSize_Click" Tag="720x405"/>
                                <MenuItem Header="🗖 Grande (1080 × 608)" Click="PresetSize_Click" Tag="1080x608"/>
                                <MenuItem Header="🖥️ Muy Grande (1280 × 720)" Click="PresetSize_Click" Tag="1280x720"/>
                                <Separator Background="#2A2A38"/>
                                <MenuItem Header="⛶ Pantalla Completa de Laptop" Click="PresetSize_Click" Tag="fullscreen"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Botón Minimizar -->
                    <Button x:Name="BtnMinimize" Grid.Column="3" Style="{StaticResource PipIconBtn}" 
                            ToolTip="Minimizar a barra de tareas (el video sigue corriendo)"
                            Click="BtnMinimize_Click" Margin="0,0,5,0" Padding="8,3"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="─" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7"/>
                    </Button>

                    <!-- Botón Maximizar / Pantalla Completa -->
                    <Button x:Name="BtnMaximize" Grid.Column="4" Style="{StaticResource PipIconBtn}" 
                            ToolTip="Maximizar a pantalla completa de la laptop o restaurar"
                            Click="BtnMaximize_Click" Margin="0,0,5,0" Padding="8,3"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="TxtMaximize" Text="🗖" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7"/>
                    </Button>

                    <!-- Botón Volver -->
                    <Button Grid.Column="5" Style="{StaticResource PipIconBtn}" 
                            ToolTip="Volver a la pestaña de origen (abre ventana principal)"
                            Click="BtnReturnToTab_Click" Margin="0,0,5,0" Padding="8,3"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="⇱ Volver" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC"/>
                    </Button>

                    <!-- Cerrar PiP -->
                    <Button Grid.Column="6" Style="{StaticResource CloseBtn}" 
                            ToolTip="Cerrar página flotante y pausar video" Click="BtnClose_Click" Padding="7,3"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="✕" FontSize="10" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ─── ÁREA DE PÁGINA WEB COMPLETA (Con 6px de margen lateral/inferior para que el HWND de WebView2 no bloquee el estiramiento manual) ─── -->
            <Grid x:Name="VideoContainer" Grid.Row="1" Background="#000000" Margin="6,0,6,6">
                <!-- Placeholder visible cuando no hay página cargada -->
                <StackPanel x:Name="VideoPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🗖" FontSize="36" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="Página flotante lista" 
                               Foreground="#555566" FontSize="11" HorizontalAlignment="Center" 
                               TextWrapping="Wrap" TextAlignment="Center" Margin="20,8"/>
                </StackPanel>
            </Grid>

            <!-- Controladores Win32 en TODOS los bordes y esquinas para estirar libremente en cualquier dirección -->
            <Grid Grid.RowSpan="2" Panel.ZIndex="999">
                <!-- Bordes (Arriba, Abajo, Izquierda, Derecha) -->
                <Border VerticalAlignment="Top" Height="7" Background="#01000000" Cursor="SizeNS" 
                        PreviewMouseLeftButtonDown="ResizeTop_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border VerticalAlignment="Bottom" Height="7" Background="#01000000" Cursor="SizeNS" 
                        PreviewMouseLeftButtonDown="ResizeBottom_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border HorizontalAlignment="Left" Width="7" Background="#01000000" Cursor="SizeWE" 
                        PreviewMouseLeftButtonDown="ResizeLeft_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border HorizontalAlignment="Right" Width="7" Background="#01000000" Cursor="SizeWE" 
                        PreviewMouseLeftButtonDown="ResizeRight_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- Esquinas para estiramiento diagonal suave -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Background="#01000000" Cursor="SizeNWSE" 
                        PreviewMouseLeftButtonDown="ResizeTopLeft_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Background="#01000000" Cursor="SizeNESW" 
                        PreviewMouseLeftButtonDown="ResizeTopRight_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Background="#01000000" Cursor="SizeNESW" 
                        PreviewMouseLeftButtonDown="ResizeBottomLeft_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Background="#01000000" Cursor="SizeNWSE" 
                        PreviewMouseLeftButtonDown="ResizeBottomRight_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                                IsTabStop="False" Opacity="0.75" IsHitTestVisible="False"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

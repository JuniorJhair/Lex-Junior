<Window x:Class="LexBrowser.UI.Views.PasswordVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bóveda de Contraseñas y Seguridad - Lex Junior"
        Height="680" Width="900"
        MinHeight="540" MinWidth="720"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F0F14"
        Foreground="#E4E4E7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="VaultNavRadio" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggle" TargetType="CheckBox" BasedOn="{StaticResource LexModernToggle}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Border Grid.Row="0" Background="#14141A" BorderBrush="#242430" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="🔑 Bóveda de Contraseñas y Seguridad — Lex Junior" FontWeight="Bold" FontSize="12.5" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="#A1A1AA" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Cuerpo Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú lateral -->
            <Border Grid.Column="0" Background="#121217" BorderBrush="#242430" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <TextBlock Text="SEGURIDAD Y CLAVES" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Margin="8,0,0,10"/>

                    <RadioButton x:Name="TabVaultList" Content="🔑 Contraseñas Guardadas" Style="{StaticResource VaultNavRadio}" IsChecked="True" Checked="NavTab_Checked"/>
                    <RadioButton x:Name="TabBrowserLock" Content="🔒 Contraseña del Navegador" Style="{StaticResource VaultNavRadio}" Checked="NavTab_Checked"/>

                    <Border Height="1" Background="#242430" Margin="4,16"/>

                    <!-- Cuadro informativo de las Funciones de Seguridad -->
                    <Border Background="#171723" BorderBrush="#312E81" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="✨ Protección Activa" FontWeight="Bold" FontSize="11.5" Foreground="#A5B4FC" Margin="0,0,0,6"/>
                            <TextBlock Text="🛡️ Escudo Portapapeles (20s): Al copiar una clave, se borra sola del portapapeles a los 20s."
                                       FontSize="11" Foreground="#D4D4D8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="👁️ Vistazo Seguro (5s): Al mostrar una clave, se vuelve a ocultar sola en 5 segundos."
                                       FontSize="11" Foreground="#D4D4D8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="⚡ Cifrado Nativo DPAPI: Tus claves se cifran con tu cuenta de Windows sin procesos en segundo plano."
                                       FontSize="11" Foreground="#34D399" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Contenido Principal -->
            <Grid Grid.Column="1">
                <!-- PESTAÑA 1: CONTRASEÑAS GUARDADAS -->
                <ScrollViewer x:Name="PanelVaultList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="24,18" Visibility="Visible">
                    <StackPanel>
                        <TextBlock Text="Bóveda de Contraseñas" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Detecta el dominio raíz (.com, .com.pe, .org, etc.) aunque cambie la ruta y te protege contra sitios falsos"
                                   FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,16"/>

                        <!-- Banner de notificación interna (ej. Copiado con Escudo 20s) -->
                        <Border x:Name="VaultStatusBanner" Background="#1E1B4B" BorderBrush="#4F46E5" BorderThickness="1.5"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="TxtVaultStatusBanner" Text="" Foreground="#E0E7FF" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Switch Activar / Desactivar Guardador -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                            <CheckBox x:Name="ChkEnablePasswordManager" Style="{StaticResource ModernToggle}" Click="ChkEnablePasswordManager_Click">
                                <StackPanel>
                                    <TextBlock Text="Activar Guardador y Autocompletado de Contraseñas" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Pregunta si deseas guardar tus inicios de sesión y autocompleta tu correo y clave cuando hagas clic en el campo de acceso de la misma web. Si tienes PIN configurado, lo pedirá al activar o desactivar."
                                               FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Buscador y botón Agregar manualmente -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#161620" BorderBrush="#2B2B3C" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtSearchCredentials" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="#FFFFFF" FontSize="12.5" VerticalAlignment="Center" CaretBrush="#FFFFFF"
                                             TextChanged="TxtSearchCredentials_TextChanged"/>
                                    <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Buscar por página web (.com) o por correo/usuario..."
                                               Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1" Content="＋ Agregar cuenta" Click="BtnToggleAddManual_Click"
                                    Style="{StaticResource LexPrimaryButton}" FontWeight="Bold" FontSize="12" Padding="14,8"/>
                        </Grid>

                        <!-- Formulario plegable para agregar cuenta manualmente -->
                        <Border x:Name="BorderAddManualForm" Background="#171723" BorderBrush="#3B3B54" BorderThickness="1"
                                CornerRadius="10" Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="➕ Guardar cuenta manualmente" FontWeight="Bold" FontSize="12.5" Foreground="#A5B4FC" Margin="0,0,0,8"/>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Página web o dominio (ej. google.com):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtManualDomain" Style="{StaticResource DarkInput}" Padding="8,5" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Margin="3,0">
                                        <TextBlock Text="Correo o usuario:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtManualUsername" Style="{StaticResource DarkInput}" Padding="8,5" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Contraseña:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                        <PasswordBox x:Name="PwdManualPassword" Style="{StaticResource LexPasswordBox}" Padding="8,5" FontSize="12"/>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Guardar en la Bóveda" Click="BtnSaveManualCredential_Click"
                                            Style="{StaticResource LexSuccessButton}" FontSize="11.5" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button Content="Cancelar" Click="BtnToggleAddManual_Click"
                                            Style="{StaticResource LexSecondaryButton}" FontSize="11.5" Padding="10,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lista de Contraseñas Guardadas -->
                        <TextBlock x:Name="TxtEmptyVaultState"
                                   Text="Aún no tienes contraseñas guardadas. Cuando inicies sesión en cualquier sitio web (o agregues una arriba), aparecerá aquí ordenada por su dominio (.com, .pe, etc.)."
                                   Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="20,30"/>

                        <ItemsControl x:Name="ItemsVaultCredentials">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#161620" BorderBrush="#272738" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Icono de dominio con logo oficial -->
                                            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="36" Height="36" CornerRadius="8"
                                                    Background="#25253A" BorderBrush="#3B3B58" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding FaviconImage}" Width="20" Height="20"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding DomainInitial}" FontSize="15" FontWeight="Black" Foreground="#818CF8"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasNoFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Fila 1: Dominio + Fecha a la izquierda y Botones de acción a la derecha -->
                                            <Grid Grid.Column="1" Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Domain}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                    <Button Content="↗" Tag="{Binding}" Click="BtnOpenCredentialSite_Click"
                                                            Style="{StaticResource LexGhostButton}" Foreground="#818CF8" FontWeight="Bold" FontSize="11"
                                                            Padding="5,2" MinHeight="22" MinWidth="22" Margin="4,0,8,0" ToolTip="Abrir este sitio web en una pestaña"/>
                                                    <TextBlock Text="{Binding UpdatedDisplay}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Botones de Acción -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="📋 Usuario" Tag="{Binding}" Click="BtnCopyUsername_Click"
                                                            Background="#242436" Foreground="#E4E4E7" FontSize="11" FontWeight="SemiBold" Padding="8,4"
                                                            BorderThickness="1" BorderBrush="#32324A" Margin="0,0,5,0" ToolTip="Copiar correo o usuario"/>

                                                    <Button Content="{Binding PeekButtonText}" Tag="{Binding}" Click="BtnPeekPassword_Click"
                                                            Background="#242436" Foreground="#A5B4FC" FontSize="11" FontWeight="SemiBold" Padding="8,4"
                                                            BorderThickness="1" BorderBrush="#32324A" Margin="0,0,5,0" ToolTip="Ver contraseña por 5 segundos (Auto-ocultación Anti-Mirones)"/>

                                                    <Button Content="📋 Clave" Tag="{Binding}" Click="BtnCopyPassword_Click"
                                                            Background="#4F46E5" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Padding="9,4"
                                                            BorderThickness="0" Margin="0,0,5,0" ToolTip="Copiar contraseña con Escudo de Portapapeles (se limpia sola en 20s)"/>

                                                    <Button Content="🗑️" Tag="{Binding}" Click="BtnDeleteCredential_Click"
                                                            Background="#2A161D" Foreground="#FCA5A5" BorderBrush="#7F1D1D" BorderThickness="1" FontSize="11" Padding="8,4"
                                                            ToolTip="Eliminar esta contraseña de la bóveda"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Fila 2: Usuario y Contraseña con recorte limpio (sin solapar botones nunca) -->
                                            <Grid Grid.Column="1" Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MaxWidth="260"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Usuario: " FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding UsernameDisplay}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#E4E4E7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Clave: " FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PasswordDisplay}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{Binding PasswordBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               ToolTip="{Binding PasswordDisplay}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PeekStatusBadge}" FontSize="11" Foreground="#34D399"
                                                               FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sitios excluidos ("Nunca guardar") -->
                        <Border x:Name="BorderExcludedDomainsSection" Background="#14141C" BorderBrush="#262636" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🚫 Sitios donde elegiste 'Nunca guardar contraseña'" FontWeight="Bold" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ItemsExcludedDomains">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1B1B26" CornerRadius="6" Padding="10,4" Margin="0,0,0,4">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center"/>
                                                    <Button Content="Permitir guardar de nuevo" Tag="{Binding}" Click="BtnRemoveExcludedDomain_Click"
                                                            HorizontalAlignment="Right" Background="#262638" Foreground="#818CF8" FontSize="11"
                                                            Padding="8,3" BorderThickness="0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PESTAÑA 2: CONTRASEÑA DEL NAVEGADOR, MODO INVITADO Y RECUPERACIÓN -->
                <ScrollViewer x:Name="PanelBrowserLock" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="24,18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Contraseña del Navegador y Modo Invitado" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Protege tu navegador con un PIN simple (ej. 6 dígitos o letras, sin reglas molestas) o úsalo sin contraseña"
                                   FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,16"/>

                        <!-- Selector de los 4 Modos de Bloqueo con explicación clara de lo que ocurrirá -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="1. ¿Cuándo deseas que Lex Junior te pida tu contraseña / PIN?" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                                <RadioButton x:Name="RbLockSmart" Style="{StaticResource LexRadioButton}" GroupName="LockModeGroup" Margin="0,0,0,10" Checked="LockModeRadio_Changed">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Modo Inteligente: Solo al encender la PC o tras suspender/bloquear Windows (Recomendado)" FontWeight="Bold" FontSize="12.5" Foreground="#818CF8" TextWrapping="Wrap"/>
                                        <TextBlock Text="Qué ocurrirá: Te pedirá tu PIN la primera vez que abras el navegador tras encender la PC, o si bloqueas/suspendes tu sesión de Windows (Win+L). Si cierras el navegador y lo vuelves a abrir mientras sigues usando tu PC, entrará directo sin molestarte."
                                                   FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbLockAlways" Style="{StaticResource LexRadioButton}" GroupName="LockModeGroup" Margin="0,0,0,10" Checked="LockModeRadio_Changed">
                                    <StackPanel>
                                        <TextBlock Text="🔒 Siempre que se abra el navegador" FontWeight="Bold" FontSize="12.5" Foreground="#F4F4F5" TextWrapping="Wrap"/>
                                        <TextBlock Text="Qué ocurrirá: Cada vez que cierres Lex Junior y lo vuelvas a abrir, mostrará la pantalla de PIN y el botón '👤 Entrar como Invitado' (el invitado navega en una sesión aislada sin ver tus pestañas, marcadores, historial ni contraseñas)."
                                                   FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbLockVaultOnly" Style="{StaticResource LexRadioButton}" GroupName="LockModeGroup" Margin="0,0,0,10" Checked="LockModeRadio_Changed">
                                    <StackPanel>
                                        <TextBlock Text="🔑 Solo para ver contraseñas guardadas o desactivar el guardador (Navegador libre)" FontWeight="Bold" FontSize="12.5" Foreground="#F4F4F5" TextWrapping="Wrap"/>
                                        <TextBlock Text="Qué ocurrirá: El navegador abrirá directo siempre, pero pedirá tu PIN cuando alguien intente abrir esta Bóveda, ver/copiar una contraseña o desactivar el guardador."
                                                   FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbLockNone" Style="{StaticResource LexRadioButton}" GroupName="LockModeGroup" Checked="LockModeRadio_Changed">
                                    <StackPanel>
                                        <TextBlock Text="🔓 No me gustaría usar contraseña" FontWeight="Bold" FontSize="12.5" Foreground="#34D399" TextWrapping="Wrap"/>
                                        <TextBlock Text="Qué ocurrirá: Ni el navegador ni la bóveda te pedirán PIN en ningún momento. Tus contraseñas igual se guardan cifradas en disco con la llave interna de tu usuario de Windows."
                                                   FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Configuración del PIN / Contraseña y Pregunta de Recuperación -->
                        <Border x:Name="BorderPinConfiguration" Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Tarjeta de Estado: Si el PIN ya está configurado -->
                                <Border x:Name="BorderPinActiveStatus" Background="#14231A" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔒 PIN de Protección Activo" FontWeight="Bold" FontSize="13" Foreground="#34D399" VerticalAlignment="Center"/>
                                                <Border Background="#1C3827" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtPinLengthBadge" Text="Protegido" FontSize="11" Foreground="#6EE7B7" FontWeight="Bold"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="El navegador y tus contraseñas están protegidos bajo llave." FontSize="11" Foreground="#A7F3D0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="BtnChangePin" Content="🔑 Cambiar PIN / Preguntas" Click="BtnChangePin_Click"
                                                    Background="#232338" BorderBrush="#4F46E5" BorderThickness="1" Foreground="#A5B4FC" FontWeight="SemiBold" FontSize="11" Padding="10,5" Margin="0,0,0,6"/>
                                            <Button x:Name="BtnDisablePinDirect" Content="🔓 Desactivar protección" Click="BtnDisablePinDirect_Click"
                                                    Background="#261719" BorderBrush="#DC2626" BorderThickness="1" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="11" Padding="10,5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Formulario de creación o edición de PIN -->
                                <StackPanel x:Name="BorderPinForm">
                                    <TextBlock x:Name="TxtPinFormTitle" Text="2. Configura tu PIN o Contraseña y tu Método de Recuperación" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="Puedes usar un PIN de 6 dígitos (solo números) o letras a tu gusto. Sin exigencias molestas de mayúsculas ni símbolos."
                                               FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Nuevo PIN o contraseña (ej. 6 dígitos):" FontSize="11" Foreground="#D4D4D8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="PwdMasterPin" Style="{StaticResource LexPasswordBox}" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Confirmar PIN o contraseña:" FontSize="11" Foreground="#D4D4D8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="PwdMasterPinConfirm" Style="{StaticResource LexPasswordBox}" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Pregunta secreta para recuperar tu clave (Opcional):" FontSize="11" Foreground="#D4D4D8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtSecurityQuestion" Text="¿Cuál es el nombre de mi primera mascota o juego favorito?"
                                                     Style="{StaticResource DarkInput}" Padding="10,7" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Tu respuesta secreta (conserva tus claves si olvidas el PIN):" FontSize="11" Foreground="#D4D4D8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtSecurityAnswer" Style="{StaticResource DarkInput}" Padding="10,7" FontSize="12"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Button Content="💾 Guardar PIN / Contraseña y Modo de Protección" Click="BtnSaveLockSettings_Click"
                                            Style="{StaticResource LexPrimaryButton}" FontWeight="Bold" FontSize="12.5" Padding="16,10"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Tarjeta de Código de Recuperación generado -->
                                <Border x:Name="BorderRecoveryCodeDisplay" Background="#12201B" BorderBrush="#10B981" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="✅ ¡Protección activada! Tu Código de Recuperación de Emergencia es:" FontWeight="Bold" FontSize="11.5" Foreground="#34D399"/>
                                            <TextBlock x:Name="TxtGeneratedRecoveryCode" Text="LEX-0000-0000" FontWeight="Black" FontSize="15" Foreground="#FFFFFF" Margin="0,3,0,2"/>
                                            <TextBlock Text="Guárdalo o usa tu respuesta secreta si algún día olvidas tu PIN (verificación local instantánea)." FontSize="11" Foreground="#A7F3D0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋 Copiar código" Click="BtnCopyRecoveryCode_Click"
                                                Style="{StaticResource LexSuccessButton}" FontSize="11" Padding="10,6"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Explicación transparente de Recuperación y Modo Invitado -->
                        <Border Background="#15151D" BorderBrush="#272736" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="ℹ️ ¿Qué ocurre en Modo Invitado o si olvidas todo?" FontWeight="Bold" FontSize="12.5" Foreground="#A5B4FC" Margin="0,0,0,6"/>
                                <TextBlock Text="• 👤 Modo Invitado: Si otra persona abre Lex Junior y no sabe tu PIN, puede pulsar 'Entrar como Invitado'. Navegará sin ver tus pestañas, marcadores, historial ni contraseñas, y al cerrar la ventana todo lo del invitado se borra automáticamente."
                                           FontSize="11" Foreground="#D4D4D8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• 🛟 Recuperación con Pregunta Secreta o Código: Si olvidas tu PIN y respondes tu pregunta secreta (o código LEX-XXXX-XXXX), podrás elegir un nuevo PIN conservando el 100% de tus contraseñas."
                                           FontSize="11" Foreground="#D4D4D8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• ⚠️ Restablecimiento de Emergencia (si olvidas el PIN, la respuesta y el código): Podrás desbloquear el navegador borrando únicamente la bóveda de contraseñas por seguridad, pero conservando intactos tus marcadores, historial, descargas y ajustes."
                                           FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

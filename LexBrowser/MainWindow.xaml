<Window x:Class="LexBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lex Junior Browser" 
        Icon="pack://application:,,,/Assets/logo.png"
        Height="800" Width="1280"
        MinHeight="480" MinWidth="640"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F0F12"
        Foreground="#E4E4E7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="AppWindowChrome" CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colores base -->
        <SolidColorBrush x:Key="BgDark" Color="#0F0F12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#18181D"/>
        <SolidColorBrush x:Key="SurfaceLighter" Color="#22222B"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentHover" Color="#818CF8"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2E2E3A"/>
        <SolidColorBrush x:Key="TextLight" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA"/>

        <!-- Estilo botones de ventana (Minimizar, Maximizar, Cerrar) -->
        <Style x:Key="WindowCtrlBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#252530"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowCtrlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo botones de navegación -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceLighter}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón compacto para + / Incógnito al costado de las pestañas -->
        <Style x:Key="TabActionBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LexFocusVisual}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A38"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo ContextMenu para Pestañas (Tema Oscuro Elegante) -->
        <Style x:Key="TabContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#1A1A22"/>
            <Setter Property="BorderBrush" Value="#2D2D3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Margin="2,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="miBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="#8B8B96" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="miBorder" Property="Background" Value="#2E2E3E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabMenuSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#2D2D3B"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWindowGrid">
        <Grid.RowDefinitions>
            <!-- Fila 0: Barra de título con pestañas y controles de ventana -->
            <RowDefinition x:Name="RowHeader" Height="42"/>
            <!-- Fila 1: Barra de navegación, Omnibox e indicadores -->
            <RowDefinition x:Name="RowNavBar" Height="50"/>
            <!-- Fila 2: Barra de Accesos Directos Pro (Bookmarks Bar) -->
            <RowDefinition x:Name="RowBookmarksBar" Height="34"/>
            <!-- Fila 3: Fila Infobar Superior (Navegador predeterminado - CERO interferencia con WebView2) -->
            <RowDefinition x:Name="RowInfoBar" Height="Auto"/>
            <!-- Fila 4: Indicador de carga sutil -->
            <RowDefinition x:Name="RowProgressBar" Height="2"/>
            <!-- Fila 5: Contenedor del navegador (WebView2) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fila 0: Header & Tabs (Doble clic maximiza/restaura, clic arrastra) -->
        <Grid Grid.Row="0" Background="{StaticResource BgDark}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <!-- Logo & Brand LJ -->
                <ColumnDefinition Width="Auto"/>
                <!-- Tiras de Pestañas + Botones pegados a la derecha de las pestañas -->
                <ColumnDefinition Width="*"/>
                <!-- Botones Minimizar / Maximizar / Cerrar -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Logo LJ -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0" WindowChrome.IsHitTestVisibleInChrome="False">
                <Border CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="TxtBrandTitle" Text="LEX JUNIOR" FontWeight="Black" FontSize="11" Foreground="#818CF8" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Lista de Pestañas con Drag & Drop y botones pegados a la última pestaña (Ley de Fitts: se extiende hasta el tope superior y = 0) -->
            <Grid x:Name="TabStripContainer" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="TabStripContainer_SizeChanged">
                <ScrollViewer x:Name="TabsScrollViewer" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" 
                              WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Stretch"
                              PreviewMouseWheel="TabsScrollViewer_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <!-- ItemsControl de pestañas con soporte Drag & Drop -->
                        <ItemsControl x:Name="TabsItemsControl" VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabBorder" Width="{Binding TabWidth}" Margin="2,0,2,0" VerticalAlignment="Stretch" CornerRadius="6,6,0,0" Padding="10,0,8,0" Cursor="Hand"
                                            Background="#16161B" BorderBrush="Transparent" BorderThickness="0,2,0,0"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="Tab_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="Tab_PreviewMouseLeftButtonUp">
                                        <!-- Menú Contextual (Clic derecho en pestaña) -->
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource TabContextMenu}">
                                                <MenuItem Header="Nueva pestaña a la derecha" Click="MenuNewTabRight_Click" Style="{StaticResource TabMenuItem}" InputGestureText="Ctrl+T"/>
                                                <MenuItem Header="Duplicar" Click="MenuDuplicateTab_Click" Style="{StaticResource TabMenuItem}"/>
                                                <Separator Style="{StaticResource TabMenuSeparator}"/>
                                                <MenuItem Header="📌 Fijar (solo logo)" Click="MenuPinLogoOnly_Click" Style="{StaticResource TabMenuItem}"/>
                                                <MenuItem Header="📌 Fijar (logo y nombre)" Click="MenuPinLogoAndName_Click" Style="{StaticResource TabMenuItem}"/>
                                                <MenuItem Header="Desfijar pestaña" Click="MenuUnpin_Click" Style="{StaticResource TabMenuItem}"/>
                                                <Separator Style="{StaticResource TabMenuSeparator}"/>
                                                <MenuItem Header="Silenciar / Activar sonido" Click="MenuToggleMute_Click" Style="{StaticResource TabMenuItem}"/>
                                                <MenuItem Header="Mover pestaña a una nueva ventana" Click="MenuMoveToNewWindow_Click" Style="{StaticResource TabMenuItem}"/>
                                                <MenuItem Header="Volver a cargar" Click="MenuReload_Click" Style="{StaticResource TabMenuItem}" InputGestureText="Ctrl+R"/>
                                                <Separator Style="{StaticResource TabMenuSeparator}"/>
                                                <MenuItem Header="Cerrar" Click="MenuCloseTab_Click" Style="{StaticResource TabMenuItem}" InputGestureText="Ctrl+W"/>
                                                <MenuItem Header="Cerrar las demás pestañas" Click="MenuCloseOtherTabs_Click" Style="{StaticResource TabMenuItem}"/>
                                                <MenuItem Header="Cerrar pestañas a la derecha" Click="MenuCloseTabsToRight_Click" Style="{StaticResource TabMenuItem}"/>
                                                <Separator Style="{StaticResource TabMenuSeparator}"/>
                                                <MenuItem Header="Volver a abrir pestaña cerrada" Click="MenuReopenClosedTab_Click" Style="{StaticResource TabMenuItem}" InputGestureText="Ctrl+Shift+T"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid MinWidth="30" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <!-- Icono / Favicon -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Indicador pin si es con nombre -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Título de la pestaña -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Indicador de audio -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Botón Cerrar -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Favicon / Logo Real de la Página -->
                                            <Image Grid.Column="0" Source="{Binding FaviconImage}" 
                                                   Width="16" Height="16" Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasFaviconImage, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Icono Fallback cuando aún no carga el logo real -->
                                            <TextBlock Grid.Column="0" Text="{Binding FaviconIcon}" 
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"
                                                       Visibility="{Binding HasNoFaviconImage, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Indicador pin -->
                                            <TextBlock Grid.Column="1" Text="📌 " FontSize="11" 
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Título (Visible solo si no es solo logo) -->
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayTitle}" Foreground="{StaticResource TextLight}" FontSize="12" 
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Visibility="{Binding ShowTitleInTab, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Indicador de audio dinámico (🔊 o 🔇) -->
                                            <TextBlock Grid.Column="3" Text="{Binding AudioIndicatorText}" Foreground="#67E8F9" FontSize="11" Margin="4,0" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Botón Cerrar Pestaña (Layout estricto de 18x18 DIP; área de clic expandida con Margin negativo en template) -->
                                            <Button Grid.Column="4" Width="18" Height="18" Margin="4,0,0,0" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Click="CloseTab_Click" Tag="{Binding}"
                                                    ToolTip="Cerrar pestaña (Ctrl+W)"
                                                    AutomationProperties.Name="Cerrar pestaña"
                                                    Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="#A1A1AA"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid Margin="-3" Background="Transparent">
                                                                        <Border x:Name="b" Width="18" Height="18" CornerRadius="9" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock Text="✕" FontSize="11" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                        </Border>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Background" Value="#33FF3344"/>
                                                                            <Setter Property="Foreground" Value="#FF6677"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Efecto Hover cuando el puntero pasa encima de una pestaña (sombreado elegante) -->
                                        <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#252535"/>
                                        </Trigger>
                                        <!-- Pestaña seleccionada normal -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceDark}"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,0,0"/>
                                        </DataTrigger>
                                        <!-- Pestaña incógnito seleccionada -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding IsIncognito}" Value="True"/>
                                                <Condition Binding="{Binding IsGuest}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8B5CF6"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,0,0"/>
                                        </MultiDataTrigger>
                                        <!-- Pestaña modo invitado seleccionada (azul cielo elegante) -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding IsGuest}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,0,0"/>
                                        </MultiDataTrigger>
                                        <!-- Pestaña suspendida para ahorro de RAM -->
                                        <DataTrigger Binding="{Binding IsSuspendedByLex}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Botón + pegado a la última pestaña -->
                        <Button x:Name="BtnNewTab" Content="＋" Style="{StaticResource TabActionBtn}" ToolTip="Abrir nueva pestaña (Ctrl+T o Ctrl+N)"
                                AutomationProperties.Name="Abrir nueva pestaña"
                                Click="BtnNewTab_Click" Margin="4,0,2,0" VerticalAlignment="Center"/>

                        <!-- Botón Incógnito pegado al botón + -->
                        <Button x:Name="BtnNewIncognitoTab" Content="🕵️" Style="{StaticResource TabActionBtn}" ToolTip="Abrir pestaña de incógnito (Ctrl+Shift+N)"
                                AutomationProperties.Name="Abrir pestaña de incógnito"
                                Click="BtnNewIncognitoTab_Click" Margin="2,0,8,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Controles de Ventana (Minimizar, Maximizar, Cerrar) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Content="─" Style="{StaticResource WindowCtrlBtn}" Click="BtnMinimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/>
                <Button x:Name="BtnMaxRestore" Content="□" Style="{StaticResource WindowCtrlBtn}" Click="BtnMaximize_Click" ToolTip="Maximizar" AutomationProperties.Name="Maximizar"/>
                <Button x:Name="BtnClose" Content="✕" Style="{StaticResource WindowCloseBtn}" Click="BtnClose_Click" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"/>
            </StackPanel>
        </Grid>

        <!-- Fila 1: Barra de herramientas y URL Omnibox -->
        <Grid Grid.Row="1" Background="{StaticResource SurfaceDark}">
            <Grid.ColumnDefinitions>
                <!-- Botones de Navegación -->
                <ColumnDefinition Width="Auto"/>
                <!-- Omnibox (Dirección / Búsqueda) -->
                <ColumnDefinition Width="*"/>
                <!-- Botones de Utilidad (Página Flotante, Escudo, Configuración) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botones Atrás, Adelante, Recargar, Home -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                <Button x:Name="BtnBack" Style="{StaticResource NavBtn}" Content="←" FontSize="14" FontWeight="Bold"
                        ToolTip="Página anterior (Alt+←)" AutomationProperties.Name="Página anterior" Click="BtnBack_Click"/>
                <Button x:Name="BtnForward" Style="{StaticResource NavBtn}" Content="→" FontSize="14" FontWeight="Bold"
                        ToolTip="Página siguiente (Alt+→)" AutomationProperties.Name="Página siguiente" Click="BtnForward_Click"/>
                <Button x:Name="BtnRefresh" Style="{StaticResource NavBtn}" Content="↻" FontSize="14" FontWeight="Bold"
                        ToolTip="Recargar página (Ctrl+R / F5)" AutomationProperties.Name="Recargar página" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnHome" Style="{StaticResource NavBtn}" Content="⌂" FontSize="14"
                        ToolTip="Página de inicio (Nueva pestaña)" AutomationProperties.Name="Página de inicio" Click="BtnHome_Click"/>
            </StackPanel>

            <!-- Barra de Direcciones / Omnibox (Estilo Chrome / Brave con logo G y autocompletado inteligente) -->
            <Border x:Name="BorderOmnibox" Grid.Column="1" Background="{StaticResource SurfaceLighter}" CornerRadius="10" Margin="4,7" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo G multicolor de Google (visible al buscar o en Nueva Pestaña) + Icono de Seguridad HTTPS -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="BadgeGoogleOmnibox" Width="18" Height="18" CornerRadius="9" Background="#1F2432" VerticalAlignment="Center" ToolTip="Búsqueda rápida con Google">
                            <Viewbox Width="13" Height="13">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#4285F4" Data="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/>
                                    <Path Fill="#34A853" Data="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"/>
                                    <Path Fill="#FBBC05" Data="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"/>
                                    <Path Fill="#EA4335" Data="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="TxtSecurityIcon" Text="🔒" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Conexión cifrada segura (HTTPS)"/>
                    </StackPanel>

                    <!-- Input URL: Comportamiento exacto de Chrome/Brave con sugerencias en vivo -->
                    <TextBox x:Name="TxtUrl" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                             Foreground="{StaticResource TextLight}" FontSize="13" VerticalAlignment="Center"
                             CaretBrush="#FFFFFF" SelectionBrush="{StaticResource AccentColor}"
                             PreviewKeyDown="TxtUrl_PreviewKeyDown"
                             KeyDown="TxtUrl_KeyDown"
                             TextChanged="TxtUrl_TextChanged"
                             GotKeyboardFocus="TxtUrl_GotKeyboardFocus"
                             LostKeyboardFocus="TxtUrl_LostKeyboardFocus"
                             PreviewMouseDown="TxtUrl_PreviewMouseDown"/>

                    <!-- Escudo de Anuncios interactivo en la barra (Clic abre el Popover de control por sitio de LexShield) -->
                    <Border x:Name="BorderShieldBadge" Grid.Column="2" Background="#1E293B" BorderBrush="#2A3A52" BorderThickness="1"
                            CornerRadius="6" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="BorderShieldBadge_Click"
                            ToolTip="LexShield: haz clic para configurar la protección en este sitio o activar el modo compatible">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtShieldIcon" Text="🛡️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtShieldBadge" Text="0 bloqueados" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pill de Zoom en Omnibox -->
                    <Border x:Name="PillZoomIndicator" Grid.Column="3" Background="#222234" BorderBrush="#6366F1" BorderThickness="1"
                            CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Cursor="Hand" ToolTip="Zoom modificado. Clic para restablecer al 100% (o pulsa Ctrl+0)"
                            MouseLeftButtonDown="PillZoom_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 " FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtZoomValue" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#818CF8" VerticalAlignment="Center"/>
                            <TextBlock Text=" ↺" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Pill de Traducción en Omnibox (Visible en páginas con idioma extranjero o al solicitar traducción) -->
                    <Button x:Name="PillTranslateIndicator" Grid.Column="4" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                            Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Cursor="Hand" ToolTip="Traducir esta página (clic para opciones de traducción)"
                            Click="PillTranslate_Click" FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="pillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="6,2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="pillBorder" Property="Background" Value="#25354D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 " FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTranslateAction" Text="Traducir" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pill de Permiso de Notificaciones en Omnibox (Fase 1: No invasivo, estilo Brave/Chrome) -->
                    <Button x:Name="PillNotificationPermission" Grid.Column="5" Background="#261E38" BorderBrush="#8B5CF6" BorderThickness="1"
                            Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Cursor="Hand" ToolTip="Este sitio solicita permiso para enviarte notificaciones"
                            Click="PillNotificationPermission_Click" FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="pillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="6,2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="pillBorder" Property="Background" Value="#352654"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔔 " FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock Text="Notificaciones" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Popover Interactivo de Control por Sitio de LexShield (Airspace-safe) -->
            <Popup x:Name="PopupShieldPanel" PlacementTarget="{Binding ElementName=BorderShieldBadge}"
                   Placement="Bottom" VerticalOffset="6" HorizontalOffset="-210"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#151520" BorderBrush="#2D2D44" BorderThickness="1.5" CornerRadius="12" Padding="15,13" Width="345">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.72" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Encabezado con Dominio, Toggle Maestro del Sitio y Cerrar -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️ LexShield · " FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtShieldPopupDomain" Text="sitio actual" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF"
                                               VerticalAlignment="Center" MaxWidth="165" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtShieldSiteModeStatus" Text="Protección activa en este sitio" FontSize="10.5" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkShieldSiteEnabled" Grid.Column="1" Content="Activo" IsChecked="True"
                                      Foreground="#E4E4E7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                      Click="ChkShieldSiteEnabled_Click" Cursor="Hand"/>
                            <Button Grid.Column="2" Style="{StaticResource LexGhostButton}" Content="✕" Width="26" Height="26" Padding="0"
                                    Click="BtnCloseShieldPopup_Click" ToolTip="Cerrar"/>
                        </Grid>

                        <!-- Contadores desglosados por categoría en la pestaña actual -->
                        <Border Background="#101018" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="En esta pestaña:" FontSize="10.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                                <Grid Margin="0,1">
                                    <TextBlock Text="• Red bloqueada:" FontSize="11" Foreground="#D4D4D8"/>
                                    <TextBlock x:Name="TxtShieldCountNetwork" Text="0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <TextBlock Text="• Stubs VAST / IMA:" FontSize="11" Foreground="#D4D4D8"/>
                                    <TextBlock x:Name="TxtShieldCountStubs" Text="0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <TextBlock Text="• Popups / redirecciones:" FontSize="11" Foreground="#D4D4D8"/>
                                    <TextBlock x:Name="TxtShieldCountPopups" Text="0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <TextBlock Text="• Capas invisibles / cosmética:" FontSize="11" Foreground="#D4D4D8"/>
                                    <TextBlock x:Name="TxtShieldCountOverlays" Text="0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <TextBlock Text="• Telemetría 204 (silenciada):" FontSize="10.5" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="TxtShieldCountTelemetry" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Módulos por sitio -->
                        <TextBlock Text="Módulos en este sitio:" FontSize="10.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                        <StackPanel x:Name="PanelShieldSiteModules" Margin="2,0,0,8">
                            <CheckBox x:Name="ChkSiteModNetwork" Content="Filtro de red y dominios" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                            <CheckBox x:Name="ChkSiteModStubs" Content="Stubs de anuncios de video (VAST/IMA)" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                            <CheckBox x:Name="ChkSiteModPopups" Content="Anti-popups y redirecciones" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                            <CheckBox x:Name="ChkSiteModOverlays" Content="Anti-capas invisibles" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                            <CheckBox x:Name="ChkSiteModCosmetic" Content="Ocultación cosmética de banners" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                            <CheckBox x:Name="ChkSiteModCookieBanners" Content="Ocultar avisos de cookies" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                            <CheckBox x:Name="ChkSiteModVideoDefuser" Content="Acelerador genérico de reproductores" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                            <CheckBox x:Name="ChkSiteModAdapter" Content="Adaptador específico del sitio (YT/DM)" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Click="ChkShieldSiteModule_Click" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock Text="ℹ️ Los cambios de script se aplican al recargar." FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,8"/>

                        <!-- Acciones rápidas: Modo compatible, Recargar ahora y Copiar diagnóstico -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnShieldCompatMode" Grid.Column="0" Style="{StaticResource LexSecondaryButton}"
                                    Content="⚡ Modo compatible" FontSize="11" FontWeight="SemiBold" Padding="8,6"
                                    Click="BtnShieldCompatMode_Click" ToolTip="Desactiva hooks agresivos (overlays, cosmética y acelerador) en este sitio y recarga"/>
                            <Button x:Name="BtnShieldReloadNow" Grid.Column="2" Style="{StaticResource LexPrimaryButton}"
                                    Content="↻ Recargar ahora" FontSize="11" FontWeight="Bold" Padding="8,6"
                                    Click="BtnShieldReloadNow_Click" ToolTip="Aplicar scripts actualizados y recargar la pestaña"/>
                        </Grid>

                        <Button x:Name="BtnShieldCopyTabDiag" Style="{StaticResource LexGhostButton}"
                                Content="📋 Copiar diagnóstico de esta pestaña" FontSize="10.5" Foreground="#93C5FD"
                                HorizontalAlignment="Stretch" Padding="6,5" Click="BtnShieldCopyTabDiag_Click"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Popup Nativo de Traducción de Páginas Web (Nivel Senior, sin banners invasivos) -->
            <Popup x:Name="PopupTranslate" PlacementTarget="{Binding ElementName=PillTranslateIndicator}"
                   Placement="Bottom" VerticalOffset="6" HorizontalOffset="-140"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#161622" BorderBrush="#2D2D42" BorderThickness="1.5" CornerRadius="12" Padding="14,12" MinWidth="290" MaxWidth="340">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Encabezado con Icono y Botón Cerrar -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Traducir página" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource LexGhostButton}" Content="✕" Width="28" Height="28" Padding="0"
                                    HorizontalAlignment="Right" Click="BtnCloseTranslatePopup_Click" ToolTip="Cerrar"/>
                        </Grid>

                        <!-- Selector de idioma con tema oscuro completo -->
                        <TextBlock Text="Traducir al idioma:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTargetLanguage" Height="34" Margin="0,0,0,12"
                                  DisplayMemberPath="Name" SelectedValuePath="Code" MaxDropDownHeight="300"
                                  SnapsToDevicePixels="True" OverridesDefaultStyle="True">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#171722"/>
                                    <Setter Property="Foreground" Value="#F4F4F5"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A3D"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="28"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                                                                Background="#1B1B26" BorderBrush="#35354A" BorderThickness="1"/>
                                                        <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A1A1AA"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter TargetName="Border" Property="Background" Value="#222232"/>
                                                            <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="#F4F4F5"/>
                                            </TextBlock.Foreground>
                                        </ContentPresenter>
                                        <Popup x:Name="Popup" Placement="Bottom"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                                  MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280">
                                                <Border x:Name="DropDownBorder" Background="#161622" BorderBrush="#2D2D42"
                                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,4">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.6" Color="Black"/>
                                                    </Border.Effect>
                                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="False" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                        </ComboBox>

                        <!-- Botones de Acción -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnDoTranslate" Grid.Column="0" Content="Traducir" Height="30" Margin="0,0,6,0"
                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0"
                                    Cursor="Hand" Click="BtnDoTranslate_Click" FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnRestoreTranslate" Grid.Column="1" Style="{StaticResource LexSecondaryButton}"
                                    Content="Ver original" Height="30" Padding="12,0" Click="BtnRestoreTranslate_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Popup Discreto de Permiso de Notificaciones (Fase 1: No invasivo, estilo Brave/Chrome) -->
            <Popup x:Name="PopupNotificationPermission" PlacementTarget="{Binding ElementName=PillNotificationPermission}"
                   Placement="Bottom" VerticalOffset="6" HorizontalOffset="-160"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#161622" BorderBrush="#2D2D42" BorderThickness="1.5" CornerRadius="12" Padding="14,12" MinWidth="320" MaxWidth="360">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Encabezado con Icono y Sitio -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔔" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNotificationPromptTitle" Text="Notificaciones del sitio" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource LexGhostButton}" Content="✕" Width="26" Height="26" Padding="0"
                                    HorizontalAlignment="Right" Click="BtnNotificationDismiss_Click" ToolTip="Cerrar"/>
                        </Grid>

                        <TextBlock x:Name="TxtNotificationPromptMessage" Text="Este sitio solicita permiso para enviarte alertas y novedades en el escritorio."
                                   FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="16"/>

                        <!-- Botones de Acción -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Permitir -->
                            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,4,6" Height="30"
                                    Background="#6366F1" BorderBrush="#818CF8" BorderThickness="1"
                                    Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                    Click="BtnNotificationAllow_Click" ToolTip="Permitir notificaciones con avisos emergentes">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="Permitir" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Permitir en silencio -->
                            <Button Grid.Row="0" Grid.Column="1" Margin="4,0,0,6" Height="30"
                                    Background="#222234" BorderBrush="#3D3D56" BorderThickness="1"
                                    Foreground="#E4E4E7" FontSize="11.5" FontWeight="Medium" Cursor="Hand"
                                    Click="BtnNotificationSilent_Click" ToolTip="Permitir solo en el centro de notificaciones, sin avisos emergentes">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="Silencioso" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Ahora no -->
                            <Button Grid.Row="1" Grid.Column="0" Margin="0,2,4,0" Height="28"
                                    Background="Transparent" BorderBrush="#2D2D42" BorderThickness="1"
                                    Foreground="#A1A1AA" FontSize="11" FontWeight="Medium" Cursor="Hand"
                                    Click="BtnNotificationDismiss_Click" ToolTip="No otorgar permiso por ahora">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="Ahora no" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Bloquear -->
                            <Button Grid.Row="1" Grid.Column="1" Margin="4,2,0,0" Height="28"
                                    Background="#25161A" BorderBrush="#4C222A" BorderThickness="1"
                                    Foreground="#F87171" FontSize="11" FontWeight="Medium" Cursor="Hand"
                                    Click="BtnNotificationBlock_Click" ToolTip="Bloquear permanentemente las notificaciones de este sitio">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="Bloquear" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Desplegable Inteligente de Sugerencias del Omnibox (Búsquedas recientes, Autocompletado de Google y Páginas visitadas) -->
            <Popup x:Name="PopupOmniboxSuggestions" PlacementTarget="{Binding ElementName=BorderOmnibox}" Placement="Bottom"
                   VerticalOffset="4" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None">
                <Border Background="#1D1D28" BorderBrush="#34344A" BorderThickness="1.5" CornerRadius="12" Padding="6,6"
                        Width="{Binding ActualWidth, ElementName=BorderOmnibox}" MinWidth="360">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <ItemsControl x:Name="ItemsOmniboxSuggestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SugRowBorder" Background="Transparent" CornerRadius="8" Padding="10,7" Margin="0,1" Cursor="Hand"
                                        PreviewMouseLeftButtonDown="OmniboxSuggestionRow_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icono (Favicon Oficial, 🕒 reciente, 🔍 búsqueda) -->
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="{Binding IconBgHex}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding FaviconImage}" Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding IconText}" Foreground="{Binding IconFgHex}" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasNoFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Texto principal + URL o subtítulo en azul (Grid con elipsis adaptable) -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MaxWidth="420"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PrimaryText}" Foreground="#F4F4F5" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SecondaryText}" Foreground="#60A5FA" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasSecondaryText, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>

                                        <!-- Botón ✕ para borrar búsqueda reciente o entrada del historial -->
                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}"
                                                PreviewMouseLeftButtonDown="BtnDeleteOmniboxSuggestion_MouseDown"
                                                Background="Transparent" BorderThickness="0" Foreground="#A1A1AA" FontSize="11"
                                                Padding="6,2" Cursor="Hand" VerticalAlignment="Center"
                                                ToolTip="Eliminar esta sugerencia del historial"
                                                AutomationProperties.Name="Eliminar sugerencia"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SugRowBorder" Property="Background" Value="#2D2D42"/>
                                    </DataTrigger>
                                    <Trigger SourceName="SugRowBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SugRowBorder" Property="Background" Value="#262638"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!-- Botones a la derecha: Lex TV, Página Flotante, Amplificador de Volumen (300%), Detector Multimedia, 0 Telemetría y Configuración -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,8,0">
                <!-- Botón Lex TV (IPTV bajo demanda) -->
                <Button x:Name="BtnLiveTv" Style="{StaticResource NavBtn}" Width="Auto" Margin="2,0"
                        ToolTip="Lex TV: TV en vivo (IPTV bajo demanda, 0% consumo al cerrar)" Click="BtnLiveTv_Click">
                    <Border Background="#252536" CornerRadius="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📺" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="TV" Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Botón Página Flotante (Controlable desde configuración) -->
                <Button x:Name="BtnTogglePip" Style="{StaticResource NavBtn}" Width="Auto" Margin="2,0" 
                        ToolTip="Página Flotante: ver la página web completa en una mini ventana flotante" Click="BtnTogglePip_Click">
                    <Border Background="#252536" CornerRadius="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗖" FontSize="12" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPipBtnLabel" Text="Página Flotante" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Botón Amplificador de Volumen (Hasta 300% estilo Volume Master) -->
                <Button x:Name="BtnVolumeBooster" Style="{StaticResource NavBtn}" Width="Auto" Margin="2,0"
                        ToolTip="Amplificador de Volumen: ajusta el volumen de esta pestaña hasta 300%" Click="BtnVolumeBooster_Click">
                    <Border x:Name="BorderVolumeBooster" Background="#252536" CornerRadius="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVolumeBoosterIcon" Text="🔊" FontSize="11" Margin="0,0,4,0" Foreground="#38BDF8"/>
                            <TextBlock x:Name="TxtVolumeBoosterLabel" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextLight}"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Popup Amplificador de Volumen (0% a 300%) -->
                <Popup x:Name="PopupVolumeBooster" PlacementTarget="{Binding ElementName=BtnVolumeBooster}" Placement="Bottom"
                       VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#181822" BorderBrush="#3B3B52" BorderThickness="1.5" CornerRadius="12" Padding="16,14" Width="310">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔊 " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Amplificador de Volumen" Foreground="#F4F4F5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#26263A" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtVolumePopupValue" Text="100%" Foreground="#818CF8" FontSize="12" FontWeight="Black"/>
                                </Border>
                            </Grid>

                            <!-- Barra horizontal de volumen (0% a 300%) -->
                            <Slider x:Name="SliderVolumeBoost" Minimum="0" Maximum="300" Value="100"
                                    TickFrequency="5" IsSnapToTickEnabled="False" Cursor="Hand"
                                    ValueChanged="SliderVolumeBoost_ValueChanged" Margin="0,4,0,4"/>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="0%" Foreground="#8B8B96" FontSize="10.5" HorizontalAlignment="Left"/>
                                <TextBlock Text="100%" Foreground="#A1A1AA" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="85,0,0,0"/>
                                <TextBlock Text="200%" Foreground="#8B8B96" FontSize="10.5" HorizontalAlignment="Right" Margin="0,0,82,0"/>
                                <TextBlock Text="300% Máx" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Botones de preajuste y Restablecer -->
                            <UniformGrid Columns="4" Margin="0,2,0,0">
                                <Button Style="{StaticResource LexPrimaryButton}" Content="↺ 100%" Click="BtnVolumeReset_Click" Margin="0,0,4,0" Padding="6,5"
                                        FontSize="11" FontWeight="Bold" ToolTip="Restablecer volumen original al 100%"/>
                                <Button Style="{StaticResource LexSecondaryButton}" Content="150%" Tag="150" Click="BtnVolumePreset_Click" Margin="2,0" Padding="6,5"
                                        FontSize="11" FontWeight="SemiBold"/>
                                <Button Style="{StaticResource LexSecondaryButton}" Content="200%" Tag="200" Click="BtnVolumePreset_Click" Margin="2,0" Padding="6,5"
                                        FontSize="11" FontWeight="SemiBold"/>
                                <Button Style="{StaticResource LexSecondaryButton}" Content="300%" Tag="300" Click="BtnVolumePreset_Click" Margin="4,0,0,0" Padding="6,5"
                                        Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Botón Detector Multimedia y Archivos Bajo Demanda -->
                <Button x:Name="BtnMediaSniffer" Style="{StaticResource NavBtn}" Width="Auto" Margin="2,0"
                        ToolTip="Detector Multimedia Bajo Demanda: detecta y descarga videos, audios, imágenes y documentos de la página"
                        Click="BtnMediaSniffer_Click">
                    <Border x:Name="BorderMediaSniffer" Background="#252536" CornerRadius="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotMediaSnifferStatus" Width="6" Height="6" Fill="#8B8B96" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="📥" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtMediaSnifferLabel" Text="Multimedia" Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Popup Detector Multimedia Bajo Demanda -->
                <Popup x:Name="PopupMediaSniffer" PlacementTarget="{Binding ElementName=BtnMediaSniffer}" Placement="Bottom"
                       VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#181822" BorderBrush="#3B3B52" BorderThickness="1.5" CornerRadius="12" Padding="14" Width="430">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Encabezado y botón de activación bajo demanda -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="📥 Detector Multimedia y Documentos" Foreground="#F4F4F5" FontSize="12.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtSnifferStatusSubtitle" Text="Apagado (0 MB RAM en reposo)" Foreground="#9CA3AF" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button x:Name="BtnToggleSnifferActive" Grid.Column="1" Click="BtnToggleSnifferActive_Click"
                                        Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                                        Padding="12,6" BorderThickness="0" Cursor="Hand" MinHeight="28"
                                        FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock x:Name="TxtToggleSnifferBtn" Text="⚡ Activar aquí"/>
                                </Button>
                            </Grid>

                            <!-- Opciones de persistencia y acciones rápidas -->
                            <Grid Margin="0,0,0,10">
                                <CheckBox x:Name="ChkKeepSnifferOnNavigate" Content="Mantener activo al cambiar de página"
                                          Foreground="#D4D4D8" FontSize="11" VerticalAlignment="Center"
                                          Checked="ChkKeepSnifferOnNavigate_Changed" Unchecked="ChkKeepSnifferOnNavigate_Changed"
                                          ToolTip="Si está desmarcado, el detector se apaga y libera memoria automáticamente al salir o recargar la página"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource LexSecondaryButton}" Content="🔄 Escanear" Click="BtnRescanMedia_Click"
                                            FontSize="10.5" Padding="8,4" MinHeight="26" Margin="0,0,4,0"
                                            ToolTip="Volver a escanear elementos de la página actual"/>
                                    <Button Style="{StaticResource LexSecondaryButton}" Content="🗑️ Limpiar" Click="BtnClearMedia_Click"
                                            FontSize="10.5" Padding="8,4" MinHeight="26" Foreground="#A1A1AA"
                                            ToolTip="Limpiar lista detectada"/>
                                </StackPanel>
                            </Grid>

                            <!-- Filtros por tipo (Separados: Todos, Video, Audio, Imagen, Docs) -->
                            <UniformGrid Columns="5" Margin="0,0,0,8">
                                <Button x:Name="BtnFilterAll" Content="Todos" Tag="Todos" Click="BtnMediaFilter_Click"
                                        Background="#6366F1" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" Padding="4,4" Margin="0,0,2,0" BorderThickness="0" Cursor="Hand"
                                        FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnFilterVideo" Content="🎬 Video" Tag="Video" Click="BtnMediaFilter_Click"
                                        Background="#252534" Foreground="#D4D4D8" FontSize="10.5" Padding="4,4" Margin="2,0" BorderThickness="0" Cursor="Hand"
                                        FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnFilterAudio" Content="🎵 Audio" Tag="Audio" Click="BtnMediaFilter_Click"
                                        Background="#252534" Foreground="#D4D4D8" FontSize="10.5" Padding="4,4" Margin="2,0" BorderThickness="0" Cursor="Hand"
                                        FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnFilterImage" Content="🖼️ Imagen" Tag="Imagen" Click="BtnMediaFilter_Click"
                                        Background="#252534" Foreground="#D4D4D8" FontSize="10.5" Padding="4,4" Margin="2,0" BorderThickness="0" Cursor="Hand"
                                        FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnFilterDoc" Content="📄 Docs" Tag="Documento" Click="BtnMediaFilter_Click"
                                        Background="#252534" Foreground="#D4D4D8" FontSize="10.5" Padding="4,4" Margin="2,0,0,0" BorderThickness="0" Cursor="Hand"
                                        FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </UniformGrid>

                            <!-- Lista de archivos detectados -->
                            <Border Background="#12121A" BorderBrush="#272736" BorderThickness="1" CornerRadius="8" Padding="6" Height="230">
                                <Grid>
                                    <TextBlock x:Name="TxtMediaEmptyState"
                                               Text="Presiona '⚡ Activar aquí' para detectar videos, audios, imágenes de alta resolución y documentos (PDF, ZIP, Office) en esta página."
                                               Foreground="#8B8B96" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18"/>

                                    <ScrollViewer x:Name="ScrollDetectedMedia" VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Visibility="Collapsed">
                                        <ItemsControl x:Name="ItemsDetectedMedia">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1B1B26" BorderBrush="#2A2A3C" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icono + Formato -->
                                                            <Border Grid.Column="0" Background="#28283C" CornerRadius="5" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding CategoryIcon}" FontSize="11" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding FormatBadge}" Foreground="#818CF8" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Nombre y Tamaño -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding FileName}" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                                                                <TextBlock Text="{Binding SizeDisplay}" Foreground="#9CA3AF" FontSize="10.5"/>
                                                            </StackPanel>

                                                            <!-- Copiar enlace -->
                                                            <Button Grid.Column="2" Style="{StaticResource LexSecondaryButton}" Content="📋" Tag="{Binding}" Click="BtnCopyMediaUrl_Click"
                                                                    FontSize="11" Padding="8,4" MinHeight="26" MinWidth="26" Margin="0,0,4,0"
                                                                    VerticalAlignment="Center" ToolTip="Copiar enlace directo"/>

                                                            <!-- Descargar archivo -->
                                                            <Button Grid.Column="3" Style="{StaticResource LexSuccessButton}" Content="⬇ Descargar" Tag="{Binding}" Click="BtnDownloadDetectedMedia_Click"
                                                                    FontSize="10.5" Padding="10,4" MinHeight="26"
                                                                    VerticalAlignment="Center" ToolTip="Descargar archivo a tu equipo"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>


                <!-- Pill Sin Telemetría (Clic abre la pestaña explicativa en Configuración) -->
                <Border x:Name="BorderTelemetryBadge" Background="#16161D" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" Margin="2,0" 
                        Cursor="Hand" MouseLeftButtonDown="BadgeTelemetry_Click" ToolTip="Sin telemetría propia: haz clic para ver los controles de privacidad">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTelemetryLabel" Text="Sin telemetría" Margin="6,0,0,0" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Botón de Actualización Disponible (Solo aparece automáticamente cuando existe una nueva versión en GitHub) -->
                <Button x:Name="BtnUpdateAvailable" Style="{StaticResource NavBtn}" Width="Auto" MinWidth="110" Margin="4,0" Visibility="Collapsed"
                        ToolTip="¡Nueva versión de Lex Junior disponible! Haz clic para actualizar automáticamente"
                        Click="BtnUpdateAvailable_Click">
                    <Border Background="#065F46" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⬆️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUpdateAvailableLabel" Text="Actualizar" FontSize="11" FontWeight="Bold" Foreground="#ECFDF5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Botón Bóveda de Contraseñas y Seguridad 🔑 (0% CPU en reposo) -->
                <Button x:Name="BtnPasswordVault" Style="{StaticResource NavBtn}" ToolTip="Bóveda de Contraseñas y Bloqueo por PIN (Ctrl+Shift+K)"
                        AutomationProperties.Name="Bóveda de contraseñas" Click="BtnPasswordVault_Click">
                    <TextBlock Text="🔑" FontSize="13" Foreground="#A1A1AA"/>
                </Button>

                <!-- Botón Historial de Descargas ⬇ (0% CPU en reposo) -->
                <Button x:Name="BtnDownloads" Style="{StaticResource NavBtn}" ToolTip="Historial de Descargas (Ctrl+J)"
                        AutomationProperties.Name="Historial de descargas" Click="BtnDownloads_Click">
                    <TextBlock x:Name="TxtDownloadsBtnIcon" Text="⬇" FontSize="13.5" FontWeight="Bold" Foreground="#A1A1AA"/>
                </Button>

                <!-- Popup del Historial de Descargas -->
                <Popup x:Name="PopupDownloads" PlacementTarget="{Binding ElementName=BtnDownloads}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" HorizontalOffset="-330">
                    <Border Background="#181822" BorderBrush="#312E81" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Width="400">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⬇ Historial de Descargas" Foreground="#F4F4F5" FontSize="12.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtDownloadsCountSubtitle" Text="Ligero · 0% consumo en segundo plano" Foreground="#9CA3AF" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource LexSecondaryButton}" Content="📂 Carpeta" Click="BtnOpenDownloadsFolder_Click"
                                            FontSize="10.5" Padding="8,4" MinHeight="26" Margin="0,0,5,0"
                                            ToolTip="Abrir la carpeta de Descargas de Windows"/>
                                    <Button Style="{StaticResource LexSecondaryButton}" Content="🗑️ Limpiar" Click="BtnClearDownloadsHistory_Click"
                                            FontSize="10.5" Padding="8,4" MinHeight="26" Foreground="#A1A1AA"
                                            ToolTip="Limpiar la lista del historial de descargas (no borra tus archivos del disco)"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#12121A" BorderBrush="#272736" BorderThickness="1" CornerRadius="8" Padding="6" Height="250">
                                <Grid>
                                    <TextBlock x:Name="TxtDownloadsEmptyState"
                                               Text="Aún no hay descargas recientes."
                                               Foreground="#8B8B96" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18"/>

                                    <ScrollViewer x:Name="ScrollDownloadsHistory" VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Visibility="Collapsed">
                                        <ItemsControl x:Name="ItemsDownloadsHistory">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1B1B26" BorderBrush="#2A2A3C" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Background="#252538" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CategoryIcon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding FileName}" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                                                <TextBlock Text="{Binding StatusDisplay}" Foreground="#9CA3AF" FontSize="10.5" Margin="0,1,0,0"/>
                                                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="3.5" Foreground="#10B981" Background="#27273A" BorderThickness="0" Margin="0,3,0,0"
                                                                             Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="2" Content="▶" Tag="{Binding}" Click="BtnOpenDownloadedFile_Click"
                                                                    Background="#1E1B4B" Foreground="#A5B4FC" FontSize="10.5" FontWeight="Bold" Padding="8,4" MinHeight="26" MinWidth="26" Margin="0,0,4,0"
                                                                    BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Abrir archivo"
                                                                    FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="b" Property="Background" Value="#312E81"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter Property="Opacity" Value="0.4"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <Button Grid.Column="3" Style="{StaticResource LexSecondaryButton}" Content="📂" Tag="{Binding}" Click="BtnShowDownloadedFileInFolder_Click"
                                                                    FontSize="10.5" Padding="8,4" MinHeight="26" MinWidth="26" Margin="0,0,4,0"
                                                                    VerticalAlignment="Center" ToolTip="Mostrar en carpeta"/>

                                                            <Button Grid.Column="4" Style="{StaticResource LexGhostButton}" Content="✕" Tag="{Binding}" Click="BtnRemoveDownloadEntry_Click"
                                                                    FontSize="11" Padding="6,3" MinHeight="26" MinWidth="26"
                                                                    VerticalAlignment="Center" ToolTip="Quitar de la lista"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Botón Centro de Notificaciones 🔔 (0% CPU en reposo) -->
                <Grid>
                    <Button x:Name="BtnNotifications" Style="{StaticResource NavBtn}" ToolTip="Centro de Notificaciones (Ctrl+Shift+D para No Molestar)"
                            AutomationProperties.Name="Centro de notificaciones" Click="BtnNotifications_Click">
                        <TextBlock x:Name="TxtNotificationsBtnIcon" Text="🔔" FontSize="13" Foreground="#A1A1AA"/>
                    </Button>
                    <Border x:Name="BadgeNotifications" Background="#DC2626" CornerRadius="8" MinWidth="16" Height="16" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="TxtBadgeNotificationsCount" Text="0" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Popup Centro de Notificaciones -->
                <Popup x:Name="PopupNotifications" PlacementTarget="{Binding ElementName=BtnNotifications}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" HorizontalOffset="-320">
                    <Border Background="#161622" BorderBrush="#2D2D42" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Width="380">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Encabezado con título, botón DND y Limpiar -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🔔 Notificaciones Web" Foreground="#F4F4F5" FontSize="12.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtNotificationsSubtitle" Text="Novedades y alertas de tus sitios" Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnToggleDnd" Style="{StaticResource LexGhostButton}" Content="🔕 Silencio" Click="BtnToggleDnd_Click"
                                            FontSize="11" Padding="6,3" MinHeight="26" Margin="0,0,4,0" ToolTip="Alternar modo No Molestar (Ctrl+Shift+D)"/>
                                    <Button x:Name="BtnClearAllNotifications" Style="{StaticResource LexGhostButton}" Content="Limpiar" Click="BtnClearAllNotifications_Click"
                                            FontSize="11" Padding="6,3" MinHeight="26" ToolTip="Borrar historial de notificaciones"/>
                                </StackPanel>
                            </Grid>

                            <!-- Lista con scroll de notificaciones recientes -->
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PanelNotificationsList">
                                    <!-- Estado vacío por defecto -->
                                    <Border x:Name="PanelNotificationsEmpty" Padding="0,24" HorizontalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🔕" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="No tienes notificaciones pendientes" Foreground="#A1A1AA" FontSize="11.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Height="1" Background="#272738" Margin="0,8"/>

                            <!-- Pie de página: Enlace a Configuración -->
                            <Button Style="{StaticResource LexGhostButton}" HorizontalAlignment="Stretch" Click="BtnOpenNotificationSettings_Click" Padding="6,4">
                                <Grid>
                                    <TextBlock Text="⚙️ Administrar permisos y límites" Foreground="#818CF8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="➔" Foreground="#818CF8" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Botón Historial 🕒 -->
                <Button x:Name="BtnHistory" Style="{StaticResource NavBtn}" ToolTip="Historial de Navegación y Limpieza (Ctrl+H)"
                        AutomationProperties.Name="Historial de navegación" Click="BtnHistory_Click">
                    <TextBlock Text="🕒" FontSize="13" Foreground="#A1A1AA"/>
                </Button>

                <!-- Botón Configuración ⚙️ -->
                <Button x:Name="BtnSettings" Style="{StaticResource NavBtn}" ToolTip="Configuración del Navegador (Ctrl+,)"
                        AutomationProperties.Name="Configuración del navegador" Click="BtnSettings_Click">
                    <TextBlock Text="⚙" FontSize="15" Foreground="#A1A1AA"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Fila 2: Barra de Accesos Directos Pro (Bookmarks Bar) -->
        <Grid x:Name="RowBookmarksGrid" Grid.Row="2" Background="#121217" Height="34">
            <Grid.ContextMenu>
                <ContextMenu Style="{StaticResource TabContextMenu}">
                    <MenuItem Header="Ocultar barra de accesos directos" Click="BtnHideBookmarksBar_Click" Style="{StaticResource TabMenuItem}" InputGestureText="Ctrl+Shift+B"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.ColumnDefinitions>
                <!-- Botón dinámico de la pestaña actual (Anclar / Anclado) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Separador sutil -->
                <ColumnDefinition Width="Auto"/>
                <!-- Marcadores anclados fijos -->
                <ColumnDefinition Width="*"/>
                <!-- Botón opciones de barra y Banner de Deshacer -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botón Pestaña Actual: Color de borde brillante si está anclada, borde tenue si no -->
            <Border x:Name="BorderCurrentTabBookmark" Grid.Column="0" Margin="10,3,4,3" CornerRadius="7" 
                    Background="#1A1A24" BorderBrush="#2E2E3A" BorderThickness="1.5" Cursor="Hand"
                    MouseLeftButtonDown="CurrentTabBookmark_Click" ToolTip="Anclar / Desanclar la página actual">
                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCurrentTabBookmarkIcon" Text="＋" Foreground="#A1A1AA" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCurrentTabBookmarkTitle" Text="Anclar pestaña actual" Foreground="#E4E4E7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Separador vertical -->
            <Border Grid.Column="1" Width="1" Height="16" Background="#2A2A38" Margin="4,0,6,0" VerticalAlignment="Center"/>

            <!-- Lista horizontal de Marcadores Anclados -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                <ItemsControl x:Name="BookmarksItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="BkBorder" Margin="3,3" CornerRadius="6" Background="#181820" BorderBrush="#272736" BorderThickness="1" Padding="7,2,5,2" Cursor="Hand"
                                    MouseLeftButtonDown="BookmarkItem_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding FaviconImage}" Width="14" Height="14" Margin="0,0,5,0" 
                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DisplayIcon}" FontSize="11" Margin="0,0,5,0" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasNoFaviconImage, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#D4D4D8" FontSize="11" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                    <!-- Botón '✕' protegido (Área de clic ampliada a 22x22 de forma invisible, icono visual de 16x16) -->
                                    <Button Width="22" Height="22" Margin="3,0,0,0" Padding="0"
                                            Background="Transparent" BorderThickness="0" FontSize="11"
                                            Cursor="Hand" ToolTip="Quitar de la barra de accesos directos"
                                            AutomationProperties.Name="Quitar marcador"
                                            Click="BtnRemoveBookmark_Click" Tag="{Binding}" FocusVisualStyle="{StaticResource LexFocusVisual}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="#A1A1AA"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Background="Transparent">
                                                                <Border x:Name="xb" Width="16" Height="16" CornerRadius="8" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="✕" FontSize="11" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                </Border>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="xb" Property="Background" Value="#33FF3344"/>
                                                                    <Setter Property="Foreground" Value="#FF6677"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="BkBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BkBorder" Property="Background" Value="#222230"/>
                                    <Setter TargetName="BkBorder" Property="BorderBrush" Value="#35354A"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Menú de la barra y Banner temporal de Deshacer -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <!-- Banner temporal Deshacer (10s) -->
                <Border x:Name="UndoBanner" Background="#1F1F2E" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6"
                        Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Marcador quitado" Foreground="#D4D4D8" FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="BtnUndoBookmark" Content="Deshacer" FontWeight="Bold" FontSize="11"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnUndoBookmark_Click" Margin="6,0,0,0"
                                FocusVisualStyle="{StaticResource LexFocusVisual}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#7DD3FC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="✕" FontSize="11" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BtnCloseUndoBanner_Click" Margin="6,0,0,0" FocusVisualStyle="{StaticResource LexFocusVisual}"
                                AutomationProperties.Name="Cerrar aviso de deshacer">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#A1A1AA"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Botón para ocultar barra de accesos directos -->
                <Button Style="{StaticResource NavBtn}" Width="26" Height="26" ToolTip="Ocultar barra de accesos directos (Ctrl+Shift+B)"
                        AutomationProperties.Name="Ocultar barra de accesos directos" Click="BtnHideBookmarksBar_Click">
                    <TextBlock Text="···" FontSize="13" Foreground="#A1A1AA"/>
                </Button>
            </StackPanel>

            <!-- Banner de Modo Invitado (Cubre la barra de marcadores personales cuando alguien entra como Invitado con tono azulado exclusivo) -->
            <Border x:Name="BorderGuestSessionBanner" Grid.Column="0" Grid.ColumnSpan="4" Background="#0C1524" BorderBrush="#0284C7" BorderThickness="0,0,0,1" Visibility="Collapsed" Panel.ZIndex="10">
                <Grid Margin="14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="👤 Modo Invitado Activo: " FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock Text="Tus marcadores personales, historial y contraseñas guardadas están ocultos. Al cerrar la ventana se borrará la sesión de invitado."
                                   FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <Button Grid.Column="1" Content="🔑 Desbloquear mi cuenta con PIN" Click="BtnUnlockFromGuest_Click"
                            VerticalAlignment="Center" Background="#0369A1" Foreground="#FFFFFF"
                            FontSize="11" FontWeight="Bold" Padding="12,5" MinHeight="28" BorderThickness="0" Cursor="Hand"
                            FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#075985"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Fila 3: Banner Amable de Navegador Predeterminado (Infobar nativa superior, CERO conflicto de solapamiento con WebView2) -->
        <Border x:Name="DefaultBrowserPromptBanner" Grid.Row="3" Background="#141420" BorderBrush="#38BDF8" BorderThickness="0,0,0,1"
                Padding="16,8" Visibility="Collapsed" Panel.ZIndex="100">
            <Grid HorizontalAlignment="Center" MaxWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="✨" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="¿Te gustaría tener a Lex Junior como tu navegador predeterminado?"
                               FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Text="Hemos detectado que aún no somos tu navegador predeterminado."
                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSetAsDefault" Content="Sí, establecer" Background="#2563EB" Foreground="#FFFFFF"
                            FontWeight="SemiBold" FontSize="11.5" Padding="14,6" Cursor="Hand" Click="BtnSetAsDefault_Click" Margin="0,0,8,0"
                            FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnDismissDefaultBrowser" Content="Ahora no" Background="#262638" Foreground="#E4E4E7"
                            FontWeight="SemiBold" FontSize="11.5" Padding="12,6" Cursor="Hand" Click="BtnDismissDefaultBrowser_Click" Margin="0,0,6,0"
                            FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#32324A"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnNeverAskDefaultBrowser" Style="{StaticResource LexGhostButton}" Content="No volver a mostrar"
                            Foreground="#A1A1AA" FontSize="11" Padding="10,6" Click="BtnNeverAskDefaultBrowser_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fila 4: Barra de progreso sutil -->
        <ProgressBar x:Name="LoadingProgressBar" Grid.Row="4" Height="2" Background="Transparent" 
                     Foreground="{StaticResource AccentColor}" BorderThickness="0" Visibility="Collapsed" IsIndeterminate="True"/>

        <!-- Fila 5: Contenedor donde se inserta el WebView2 activo -->
        <Grid x:Name="BrowserContainer" Grid.Row="5" Background="#0A0A0E">
            <!-- Los WebViews de las pestañas se alojan aquí dinámicamente -->
        </Grid>

        <!-- Popup Airspace-Safe para Guardar o Actualizar Contraseña sobre WebView2 -->
        <Popup x:Name="PopupSavePassword" PlacementTarget="{Binding ElementName=BtnPasswordVault}" Placement="Bottom"
               VerticalOffset="6" HorizontalOffset="-330" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border x:Name="SavePasswordBanner" Width="365" Background="#161622" BorderBrush="#6366F1" BorderThickness="1.5"
                    CornerRadius="12" Padding="16,14" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔑 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSavePwdPromptTitle" Text="¿Guardar contraseña para este sitio?" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource LexGhostButton}" Content="✕" Width="28" Height="28" Padding="0"
                                HorizontalAlignment="Right" Click="BtnDismissSavePassword_Click" ToolTip="Cerrar" AutomationProperties.Name="Cerrar aviso"/>
                    </Grid>

                    <TextBlock x:Name="TxtSavePwdDomainSubtitle" Text="Se asociará al dominio raíz (.com) aunque cambie la ruta"
                               FontSize="11" Foreground="#A5B4FC" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <TextBlock Text="Usuario o correo:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPromptSaveUsername" Background="#101018" BorderBrush="#2D2D42" BorderThickness="1"
                             Foreground="#FFFFFF" FontSize="12" Padding="8,5" Margin="0,0,0,8"/>

                    <TextBlock Text="Contraseña:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPromptSavePasswordPlain" Grid.Column="0" Background="#101018" BorderBrush="#2D2D42" BorderThickness="1"
                                 Foreground="#34D399" FontSize="12" FontWeight="Bold" Padding="8,5" Visibility="Collapsed"/>
                        <PasswordBox x:Name="PwdPromptSavePassword" Grid.Column="0" Background="#101018" BorderBrush="#2D2D42" BorderThickness="1"
                                     Foreground="#FFFFFF" FontSize="12" Padding="8,5"/>
                        <Button x:Name="BtnPromptPeekPassword" Grid.Column="1" Style="{StaticResource LexSecondaryButton}" Content="👁️" Click="BtnPromptPeekPassword_Click"
                                FontSize="11" Padding="8,5" MinHeight="28" MinWidth="28" Margin="6,0,0,0" ToolTip="Ver por 5 segundos" AutomationProperties.Name="Mostrar u ocultar contraseña"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnConfirmSavePassword" Grid.Column="0" Style="{StaticResource LexPrimaryButton}" Content="💾 Guardar" Click="BtnConfirmSavePassword_Click"
                                FontWeight="Bold" FontSize="11.5" Padding="12,7" Margin="0,0,6,0"/>
                        <Button x:Name="BtnDismissSavePassword" Grid.Column="1" Style="{StaticResource LexSecondaryButton}" Content="Ahora no" Click="BtnDismissSavePassword_Click"
                                FontSize="11" Padding="10,7" Margin="0,0,6,0"/>
                        <Button x:Name="BtnNeverSaveForDomain" Grid.Column="2" Content="Nunca aquí" Click="BtnNeverSaveForDomain_Click"
                                Background="#2A161D" Foreground="#FCA5A5" FontSize="11" Padding="10,7" MinHeight="28"
                                BorderThickness="0" Cursor="Hand" ToolTip="No volver a preguntar en este dominio"
                                FocusVisualStyle="{StaticResource LexFocusVisual}" SnapsToDevicePixels="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#3D1F2A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Pantalla de Bloqueo al Iniciar / Reanudar Windows (Con Configuración Inicial, Modo Invitado y Recuperación) -->
        <Border x:Name="BrowserLockOverlay" Grid.Row="1" Grid.RowSpan="5" Background="#0C0C12" Visibility="Collapsed" Panel.ZIndex="2500">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" MaxWidth="500" Margin="16">
                <Border Background="#14141E" BorderBrush="#312E81" BorderThickness="1.5" CornerRadius="16" Padding="28,22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.8" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <!-- VISTA DE BIENVENIDA / CONFIGURACIÓN INICIAL AL INSTALAR O ABRIR POR PRIMERA VEZ -->
                        <StackPanel x:Name="LockOverlayFirstTimeSetupPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0" ClipToBounds="True">
                                    <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CONFIGURACIÓN DE SEGURIDAD" FontWeight="Black" FontSize="14.5" Foreground="#818CF8"/>
                                    <TextBlock Text="Elige cómo deseas proteger tu navegador y tus contraseñas" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#191927" BorderBrush="#2E2E48" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🔒 Opción 1: Proteger con PIN o Contraseña" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="Acepta 6 dígitos (ej. 123456), números o letras sin obligarte a usar mayúsculas ni símbolos especiales. Si alguien no sabe tu PIN, podrá entrar solo en Modo Invitado."
                                               FontSize="10.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Text="¿Cuándo deseas que te pida la contraseña?" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbFirstSetupLockMode" Style="{StaticResource LexComboBox}" SelectedIndex="0" Margin="0,0,0,8" Padding="8,5" FontSize="11.5">
                                        <ComboBoxItem Tag="SmartSession" Content="⚡ Inteligente: Solo al encender la PC o tras bloquear Windows (Recomendado)"/>
                                        <ComboBoxItem Tag="AlwaysOnStartup" Content="🔒 Siempre: Pedir contraseña cada vez que cierre y abra el navegador"/>
                                        <ComboBoxItem Tag="VaultOnly" Content="🔑 Solo en Bóveda: Abrir navegador directo y pedir PIN solo al ver contraseñas"/>
                                    </ComboBox>

                                    <TextBlock Text="Crea tu PIN o contraseña (ej. 6 dígitos o letras):" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="PwdFirstSetupPin" Background="#0F0F16" BorderBrush="#3B3B58" BorderThickness="1.5"
                                                 Foreground="#FFFFFF" FontSize="14" Padding="10,6" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Pregunta secreta (recuperación):" FontSize="10.5" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtFirstSetupQuestion" Text="¿Nombre de mi primera mascota?" Background="#0F0F16" BorderBrush="#2E2E46" BorderThickness="1"
                                                     Foreground="#FFFFFF" FontSize="11" Padding="7,5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tu respuesta secreta:" FontSize="10.5" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtFirstSetupAnswer" Background="#0F0F16" BorderBrush="#2E2E46" BorderThickness="1"
                                                     Foreground="#FFFFFF" FontSize="11" Padding="7,5"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="TxtFirstSetupError" Text="" Foreground="#F87171" FontSize="11" FontWeight="SemiBold"
                                               Visibility="Collapsed" Margin="0,0,0,6"/>

                                    <Button Style="{StaticResource LexPrimaryButton}" Content="✅ Activar contraseña y continuar" Click="BtnFirstSetupSavePin_Click"
                                            FontWeight="Bold" FontSize="12" Padding="12,9"/>
                                </StackPanel>
                            </Border>

                            <!-- Opción 2: No me gustaría usar contraseña -->
                            <Border Background="#181822" BorderBrush="#2A2A3C" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel>
                                    <Button Style="{StaticResource LexSecondaryButton}" Content="🔓 No me gustaría usar contraseña (Entrar directo)" Click="BtnFirstSetupSkipNoPassword_Click"
                                            FontWeight="Bold" FontSize="12" Padding="12,8" Margin="0,0,0,5"/>
                                    <TextBlock Text="¿Qué ocurrirá? Entrarás directo sin pedir PIN al abrir el navegador y este aviso no volverá a aparecer. Si más adelante deseas poner contraseña, podrás activarla en cualquier momento desde el botón 🔑 de la barra superior."
                                               FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- VISTA PRINCIPAL DE DESBLOQUEO -->
                        <StackPanel x:Name="LockOverlayPinPanel" Visibility="Visible">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border CornerRadius="10" Width="38" Height="38" Margin="0,0,10,0" ClipToBounds="True">
                                    <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LEX JUNIOR PROTEGIDO" FontWeight="Black" FontSize="15" Foreground="#818CF8"/>
                                    <TextBlock x:Name="TxtLockOverlayModeSubtitle" Text="Sesión protegida con PIN / Contraseña" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#1B1B2A" BorderBrush="#2E2E48" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,14">
                                <TextBlock Text="⚡ Entrada rápida activa: escribe tu PIN (ej. 6 dígitos) y se desbloqueará automáticamente al completar el último carácter."
                                           FontSize="11" Foreground="#A5B4FC" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Ingresa tu PIN o contraseña:" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PwdOverlayPinInput" Background="#0F0F16" BorderBrush="#3B3B58" BorderThickness="1.5"
                                         Foreground="#FFFFFF" FontSize="18" Padding="12,9"
                                         PasswordChanged="PwdOverlayPinInput_PasswordChanged"
                                         KeyDown="PwdOverlayPinInput_KeyDown"/>

                            <TextBlock x:Name="TxtOverlayPinError" Text="❌ PIN o contraseña incorrecta." Foreground="#F87171" FontSize="11.5" FontWeight="SemiBold"
                                       Margin="0,6,0,0" Visibility="Collapsed"/>

                            <Button Style="{StaticResource LexPrimaryButton}" Content="🔓 Desbloquear mi navegador" Click="BtnOverlayUnlock_Click"
                                    FontWeight="Bold" FontSize="13" Padding="14,11" Margin="0,14,0,10"/>

                            <!-- Opción Modo Invitado si no sabe la contraseña -->
                            <Border Background="#181824" BorderBrush="#2A2A3D" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,2,0,10">
                                <StackPanel>
                                    <TextBlock Text="¿No sabes la contraseña?" FontWeight="Bold" FontSize="11.5" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Puedes entrar en Modo Invitado: navegarás libremente sin ver los marcadores, historial ni contraseñas del propietario."
                                               FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,8"/>
                                    <Button Style="{StaticResource LexSecondaryButton}" Content="👤 Entrar como Invitado" Click="BtnEnterGuestMode_Click"
                                            Foreground="#E0E7FF" FontWeight="Bold" FontSize="12" Padding="12,8"/>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource LexGhostButton}" Content="🛟 ¿Olvidaste tu PIN o contraseña? Recuperar acceso" Click="BtnOverlayShowRecovery_Click"
                                    Foreground="#818CF8" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- VISTA DE RECUPERACIÓN EN LA PANTALLA DE BLOQUEO -->
                        <StackPanel x:Name="LockOverlayRecoveryPanel" Visibility="Collapsed">
                            <TextBlock Text="🛟 Recuperar Acceso al Navegador" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtOverlayRecoveryQuestion"
                                       Text="Responde tu pregunta secreta o ingresa tu Código de Recuperación (LEX-XXXX-XXXX) para conservar todas tus contraseñas:"
                                       FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBox x:Name="TxtOverlayRecoveryAnswer" Background="#0F0F16" BorderBrush="#3B3B58" BorderThickness="1"
                                     Foreground="#FFFFFF" FontSize="12.5" Padding="10,7" Margin="0,0,0,8"/>

                            <TextBlock Text="Nuevo PIN o contraseña (ej. 6 dígitos o letras):" FontSize="11" Foreground="#D4D4D8" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PwdOverlayNewPin" Background="#0F0F16" BorderBrush="#3B3B58" BorderThickness="1"
                                         Foreground="#FFFFFF" FontSize="13" Padding="10,7" Margin="0,0,0,6"/>

                            <TextBlock x:Name="TxtOverlayRecoveryError" Text="" Foreground="#F87171" FontSize="11" FontWeight="SemiBold"
                                       Visibility="Collapsed" Margin="0,0,0,6"/>

                            <Button Style="{StaticResource LexSuccessButton}" Content="✅ Verificar y guardar nuevo PIN (Conserva mis contraseñas)" Click="BtnOverlayApplyRecovery_Click"
                                    FontSize="12" Padding="12,9" Margin="0,2,0,12"/>

                            <!-- Explicación clara de Restablecimiento de Emergencia -->
                            <Border Background="#1F1218" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="⚠️ ¿Olvidaste tanto tu PIN como tu respuesta secreta?" FontWeight="Bold" FontSize="11.5" Foreground="#FCA5A5"/>
                                    <TextBlock Text="• Se eliminarán: Únicamente las contraseñas guardadas en la bóveda (por seguridad)." FontSize="10.5" Foreground="#FECACA" Margin="0,3,0,1" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Se conservarán intactos: Tus marcadores, páginas ancladas, historial, descargas y ajustes." FontSize="10.5" Foreground="#D4D4D8" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource LexDangerButton}" Content="🗑️ Restablecer acceso (Borrar solo contraseñas)" Click="BtnOverlayEmergencyReset_Click"
                                            Padding="10,6" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource LexGhostButton}" Content="← Volver a ingresar PIN" Click="BtnOverlayBackToPin_Click"
                                    Foreground="#A1A1AA" FontSize="11.5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Popup Flotante Airspace-Safe de Zoom sobre WebView2 -->
        <Popup x:Name="PopupZoomWidget" PlacementTarget="{Binding ElementName=PillZoomIndicator}" Placement="Bottom"
               VerticalOffset="6" HorizontalOffset="-80" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border x:Name="FloatingZoomWidget" Background="#181824" BorderBrush="#6366F1" BorderThickness="1.5"
                    CornerRadius="8" Padding="10,6" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LexSecondaryButton}" Content="−" Width="28" Height="28" Padding="0"
                            FontWeight="Bold" Click="BtnZoomOut_Click" ToolTip="Reducir zoom (Ctrl -)" AutomationProperties.Name="Reducir zoom"/>
                    <TextBlock x:Name="TxtFloatingZoomValue" Text="100%" Foreground="#818CF8" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Button Style="{StaticResource LexSecondaryButton}" Content="+" Width="28" Height="28" Padding="0"
                            FontWeight="Bold" Click="BtnZoomIn_Click" ToolTip="Aumentar zoom (Ctrl +)" AutomationProperties.Name="Aumentar zoom"/>
                    <Button Style="{StaticResource LexPrimaryButton}" Content="↺ 100%" FontSize="11"
                            Padding="8,3" MinHeight="28" Margin="8,0,0,0" Click="BtnZoomReset_Click"
                            ToolTip="Restablecer zoom al 100% original (Ctrl+0)"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Toast / Notificación flotante informativa sobre WebView2 (Airspace-safe) -->
        <Popup x:Name="PopupToast" PlacementTarget="{Binding ElementName=BrowserContainer}" Placement="Bottom"
               VerticalOffset="-65" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border x:Name="ToastNotification"
                    Background="#1E1E2E" BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="10"
                    Padding="16,10" Margin="0,0,0,0"
                    MouseEnter="ToastBorder_MouseEnter" MouseLeave="ToastBorder_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtToastMessage" Text="Notificación" 
                               Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnToastAction" Style="{StaticResource LexSecondaryButton}" Content="Detalles ⬇" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" 
                            Padding="10,4" MinHeight="28" Click="ToastAction_Click" Margin="12,0,0,0"/>
                    <Button Style="{StaticResource LexGhostButton}" Content="✕" Width="28" Height="28" Padding="0" FontSize="11" Click="ToastClose_Click" Margin="8,0,0,0" ToolTip="Cerrar" AutomationProperties.Name="Cerrar notificación"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
